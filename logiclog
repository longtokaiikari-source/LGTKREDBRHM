))()

-- ============================================================
--  Bootstrap logic module
--  brm5_logic.lua must be loadstrung/required AFTER this block
--  so that getgenv().Toggles / Options exist when it runs.
--  We use a proxy table so UI callbacks write directly into the
--  same table the logic reads — zero overhead, zero delay.
-- ============================================================

getgenv().Toggles = getgenv().Toggles or {}
getgenv().Options  = getgenv().Options  or {}

-- Minimal Library shim — logic only calls Library:IsTyping()
getgenv().Library = {
    IsTyping = function()
        local uis = game:GetService("UserInputService")
        return uis:GetFocusedTextBox() ~= nil
    end,
    Unloaded = false,
}

-- ============================================================
--  Load the stripped logic
--  Replace the HttpGet URL with wherever you host brm5_logic.lua
-- ============================================================

local LogicUrl = "YOUR_RAW_LOGIC_URL_HERE" -- << paste raw URL of brm5_logic.lua
loadstring(game:HttpGet(LogicUrl))()

-- After this point Combat, Combat.ESP, Combat.Movement etc. are live.
-- We grab references for UI callbacks:
local Silent           = Combat and rawget(Combat, "Silent")     -- not exposed directly;
-- Direct table refs (the logic exposes them via upvalues, not Combat fields).
-- We drive them through getgenv() shims set up below instead.

