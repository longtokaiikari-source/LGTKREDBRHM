-- ============================================================
--  Helper — grabs the logic's upvalue tables after loadstring
--  The logic stores tables in upvalues; Combat exposes some.
--  We access them through the known global Combat table.
-- ============================================================

local function getLogic()
    -- Combat is set as a global by the logic module
    local C = getgenv().LinoriaCombat or {}
    return {
        Silent    = C.Silent,
        Trigger   = C.Trigger,     -- TriggerBotSettings
        Rage      = C.Rage,
        Movement  = C.Movement,    -- M
        Gun       = C.Gun,
        Vehicle   = C.Vehicle,     -- V
        Melee     = C.Melee,       -- A
        Turret    = C.Turret,      -- T
        World     = C.World,       -- WM
        ESP       = C.ESP,         -- Sense E
    }
end

