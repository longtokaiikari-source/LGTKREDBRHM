    NailBat={Delay=0.30,Time=1.00,Reach=5},MetalBat={Delay=0.30,Time=1.00,Reach=5},
    Bat={Delay=0.30,Time=1.00,Reach=5},BatGrip={Delay=0.30,Time=1.00,Reach=5},
    Plank={Delay=0.30,Time=1.00,Reach=5},PlankNailed={Delay=0.30,Time=1.00,Reach=5},
    Crowbar={Delay=0.30,Time=1.00,Reach=5},CrowbarBlue={Delay=0.30,Time=1.00,Reach=5},
