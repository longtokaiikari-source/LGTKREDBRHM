UserInputService.InputBegan:Connect(function(input, processed)
    if env.AutoPickupToken ~= token then
        return
    end

    if rebinding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                CONFIG[rebinding] = input.KeyCode
                event(("%s rebound to %s"):format(rebinding, input.KeyCode.Name))
            end
            rebinding = nil
        end
        return
    end
    if input.KeyCode == CONFIG.ToggleKey then
        CONFIG.Enabled = not CONFIG.Enabled
        event("autopickup " .. (CONFIG.Enabled and "enabled" or "disabled"))
    elseif input.KeyCode == CONFIG.SummaryKey then
        printSummary()
    elseif input.KeyCode == CONFIG.MenuKey and menuGui then
        menuGui.Enabled = not menuGui.Enabled
    elseif input.KeyCode == CONFIG.DropKey then
        dropDecoy()
    elseif input.KeyCode == CONFIG.RecallKey then
        stopDecoy("recalled")
    elseif input.KeyCode == CONFIG.ToggleDecoyKey then
        toggleDecoy()
    elseif input.KeyCode == CONFIG.ClearSavedKey then
        clearSavedDecoy()
    elseif input.KeyCode == CONFIG.SelectKey then
        selectNpc()
    elseif input.KeyCode == CONFIG.FollowKey then
        toggleFollow()
    elseif input.KeyCode == CONFIG.AuraKey then
        toggleAura()
    end
end)

