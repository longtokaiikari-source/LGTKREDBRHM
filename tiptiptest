local function getOrigin()
    local source, position

    local actor = replicator and replicator.LocalActor
    if actor then
        local ok, pos = pcall(function()
            return actor.CFrame.Position
        end)
        if ok and typeof(pos) == "Vector3" then
            source, position = "actor.CFrame", pos
        else
            local character = actor.Character
            if typeof(character) == "Instance" then
                local ok2, pivot = pcall(character.GetPivot, character)
                if ok2 then
                    source, position = "actor.Character", pivot.Position
                end
            end
        end
    end

    if not position then
        local character = localPlayer.Character
        local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
        if root then
            source, position = "player.Character", root.Position
        elseif camera then
            source, position = "camera", camera.CFrame.Position
        end
    end

    info.source = source or "none"
    return position
end

