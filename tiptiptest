-- ============================================================================
-- Standalone Melee Aura Test — no Linoria, no tabs, just the aura + status panel.
-- Auto-targets the nearest valid NPC/zombie in range, fires the real
-- InventoryAction Slash/Impact remote events (RINGRING's approach), with a
-- one-shot LocalActor.ForceNextPosition set at swing start (confirmed against
-- ReplicatorService.lua — Update() reads-and-clears that field on its own
-- ~0.1s cycle, so setting it once per swing is correct; setting it every
-- frame fights that cycle and freezes the character).
-- Press B to toggle. Panel shows live status + a short event log.
-- ============================================================================

local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local LocalPlayer=Players.LocalPlayer

local A={
    on=false,
    range=80,
    headshot=true,
    nextSwing=0,
    targetActor=nil,
    target=nil,
    targetUID=nil,
    swings=0,
    impacts=0,
    status="idle",
    log={},
}

local function logEvent(text)
    local line=("[%s] %s"):format(os.date("%H:%M:%S"),text)
    A.log[#A.log+1]=line
    if #A.log>12 then table.remove(A.log,1) end
end
local function setStatus(text)
    if A.status~=text then A.status=text;logEvent(text) end
end

-- ---------------------------------------------------------------------------
-- Module discovery — same verified pattern as BRM5: scan getloadedmodules(),
-- require by name, cache the result.
-- ---------------------------------------------------------------------------
local _service,_net
local function findService()
    if _service then return _service end
    for _,m in ipairs(getloadedmodules()) do
        if m.Name=="ClientService" then
            local ok,value=pcall(require,m)
            if ok and type(value)=="table" and value.Replicator then _service=value;break end
        end
    end
    return _service
end
local function findNetwork()
    if _net then return _net end
    for _,m in ipairs(getloadedmodules()) do
        if m.Name=="network" then
            local ok,value=pcall(require,m)
            if ok and type(value)=="table" and type(rawget(value,"FireServer"))=="function" then
                _net=value;break
            end
        end
    end
    return _net
end

-- ---------------------------------------------------------------------------
-- Classification — verified against ActorClass.lua / ReplicatorService.lua:
-- actor.UID is never a real property, only a dictionary key. Classify off the
-- actor's own real fields instead (Owner, Zombie, IsLocalPlayer).
-- ---------------------------------------------------------------------------
local function actorKind(actor)
    if not actor then return nil end
    local service=findService()
    local replicator=service and service.Replicator
    if actor.IsLocalPlayer or actor.Owner==LocalPlayer or (replicator and actor==replicator.LocalActor) then
        return nil
    end
    if actor.Zombie==true then return "Zombies" end
    if actor.Owner==nil then return "NPCs" end
    if typeof(actor.Owner)=="Instance" and actor.Owner:IsA("Player") then return "Players" end
end
local function isAlive(actor)
    if not actor or actor.Alive==false then return false end
    if actor.Zombie then
        return type(actor.Health)=="table" or (type(actor.Health)=="number" and actor.Health>0)
    end
    return true
end
local function allowed(actor)
    local kind=actorKind(actor)
    return kind=="Zombies" or kind=="NPCs"
end

local function myActor()
    local service=findService()
    return service and service.Replicator and service.Replicator.LocalActor
end

-- ---------------------------------------------------------------------------
-- Target selection — nearest valid actor's Head (or UpperTorso fallback)
-- within A.range studs. uid comes from the Replicator.Actors loop KEY, which
-- is the only place a correct UID actually exists.
-- ---------------------------------------------------------------------------
local function selectTarget(me)
    if not me or not me.CFrame then return nil end
    local service=findService()
    local replicator=service and service.Replicator
    local origin=me.CFrame.Position
    local best,bestPart,bestUID,nearest=nil,nil,nil,A.range
    for uid,target in pairs(replicator and replicator.Actors or {}) do
        if allowed(target) and isAlive(target) then
            local parts=target.Parts
            local part=(A.headshot and parts and parts.Head) or (parts and (parts.Head or parts.UpperTorso))
            if part and part.Parent then
                local distance=(part.Position-origin).Magnitude
                if distance>.001 and distance<=nearest then
                    best=target;bestPart=part;bestUID=uid;nearest=distance
                end
            end
        end
    end
    return best,bestPart,bestUID
end

-- ---------------------------------------------------------------------------
-- The aura step itself.
-- ---------------------------------------------------------------------------
local function auraStep()
    if not A.on then return end
    local me=myActor()
    if not me then setStatus("waiting for local actor");return end

    A.targetActor,A.target,A.targetUID=selectTarget(me)
    if not A.targetActor or not A.target or not A.targetUID then
        setStatus("waiting for a target");return
    end

    local net=findNetwork()
    if not net then setStatus("network module not found");return end

    local now=os.clock()
    if now<A.nextSwing then return end
    A.nextSwing=now+.5 -- fixed swing pace; adjust to taste

    local uid=A.targetUID
    local part=A.target
    local targetName=A.targetActor.Character and A.targetActor.Character.Name or "?"
    setStatus(("swinging at %s (%s)"):format(A.headshot and "Head" or (part.Name or "?"),targetName))

    -- One-shot ForceNextPosition at swing start — see header note.
    local la=myActor()
    if la then pcall(function() la.ForceNextPosition=part.Position end) end

    pcall(function() net:FireServer("InventoryAction","Slash",math.random(1,3)) end)
    A.swings=A.swings+1

    task.delay(.3,function()
        if not (A.on and part.Parent) then return end
        local partName=A.headshot and "Head" or part.Name
        local pos=part.Position
        pcall(function() net:FireServer("InventoryAction","Impact",{pos.X,pos.Y,pos.Z},uid,partName) end)
        A.impacts=A.impacts+1
        if A.impacts%5==0 then logEvent(("%d impacts sent"):format(A.impacts)) end
    end)
end

-- ---------------------------------------------------------------------------
-- Simple status panel — no buttons, no drag logic, just a readout.
-- ---------------------------------------------------------------------------
local gui=Instance.new("ScreenGui")
gui.Name="MeleeAuraTest";gui.ResetOnSpawn=false;gui.DisplayOrder=999
pcall(function() gui.Parent=(gethui and gethui()) or game:GetService("CoreGui") end)
if not gui.Parent then gui.Parent=LocalPlayer:WaitForChild("PlayerGui") end

local frame=Instance.new("Frame")
frame.Size=UDim2.fromOffset(280,190);frame.Position=UDim2.fromOffset(20,120)
frame.BackgroundColor3=Color3.fromRGB(18,18,22);frame.BackgroundTransparency=.1
frame.BorderSizePixel=0;frame.Parent=gui
Instance.new("UICorner",frame).CornerRadius=UDim.new(0,6)

local statusLabel=Instance.new("TextLabel")
statusLabel.Position=UDim2.fromOffset(8,8);statusLabel.Size=UDim2.fromOffset(264,70)
statusLabel.BackgroundTransparency=1;statusLabel.Font=Enum.Font.Code;statusLabel.TextSize=12
statusLabel.TextXAlignment=Enum.TextXAlignment.Left;statusLabel.TextYAlignment=Enum.TextYAlignment.Top
statusLabel.TextColor3=Color3.fromRGB(210,215,225);statusLabel.Text="";statusLabel.Parent=frame

local logLabel=Instance.new("TextLabel")
logLabel.Position=UDim2.fromOffset(8,82);logLabel.Size=UDim2.fromOffset(264,100)
logLabel.BackgroundTransparency=1;logLabel.Font=Enum.Font.Code;logLabel.TextSize=11
logLabel.TextWrapped=true;logLabel.TextXAlignment=Enum.TextXAlignment.Left
logLabel.TextYAlignment=Enum.TextYAlignment.Bottom;logLabel.TextColor3=Color3.fromRGB(170,215,175)
logLabel.Text="";logLabel.Parent=frame

RunService.RenderStepped:Connect(function()
    local targetName=A.targetActor and A.targetActor.Character and A.targetActor.Character.Name or "-"
    statusLabel.Text=table.concat({
        ("melee aura: %s    headshot: %s"):format(A.on and "ON" or "OFF",A.headshot and "ON" or "OFF"),
        ("target: %s    range: %d studs"):format(targetName,A.range),
        ("swings: %d    impacts: %d"):format(A.swings,A.impacts),
        ("status: %s"):format(A.status),
    },"\n")
    logLabel.Text=table.concat(A.log,"\n")
end)

RunService.Heartbeat:Connect(function()
    local ok,err=pcall(auraStep)
    if not ok then setStatus("error: "..tostring(err)) end
end)

UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.KeyCode==Enum.KeyCode.B then
        A.on=not A.on
        setStatus(A.on and "enabled" or "disabled")
        if not A.on then
            local la=myActor()
            if la then pcall(function() la.ForceNextPosition=nil end) end
        end
    end
end)

logEvent("melee aura test loaded — press B to toggle")
