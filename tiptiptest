local function findNetwork()
    for _, t in getgc(true) do
        if type(t) == "table"
            and rawget(t, "_events") ~= nil
            and rawget(t, "_functions") ~= nil
            and rawget(t, "_code") ~= nil
            and rawget(t, "_key") ~= nil
            and type(t.FireServer) == "function"
        then
            return t
        end
    end
    return nil
end

local function findReplicator()
    for _, t in getgc(true) do
        if type(t) == "table" then
            local actors = rawget(t, "Actors")
            local localActor = rawget(t, "LocalActor")
            if type(actors) == "table" and type(localActor) == "table" then
                local ok, cf = pcall(function()
                    return localActor.CFrame
                end)
                if ok and typeof(cf) == "CFrame" then
                    return t
                end
            end
        end
    end
    return nil
end

