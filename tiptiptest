local AK = {
    Enabled     = false,
    Range       = 9999,    -- studs, 9999 = toàn map
    Interval    = 0.1,     -- giây giữa mỗi batch tick
    BatchSize   = 5,       -- target mỗi batch

    -- Spoof config — từ source analysis
    -- Reach min=5st (Melee.lua), offset=1.5st → 1.5 < 5 → luôn PASS
    SpoofOffset  = 1.5,    -- khoảng cách spoofPos–hitPos (studs)

    -- MeleeDelay: từ Melee.lua Delay field = 0.25s
    -- Slash → task.delay(Delay, Impact) — phải đúng với legit timing
    MeleeDelay   = 0.25,

    TargetPart   = "Head",
    _lastFire    = 0,
    _conn        = nil,
    _running     = false,
    _lock        = false,
}

-- ============================================================
-- AK_Fire — chuỗi spoof + Slash→delay→Impact
--
-- Timeline:
--   t=0.000  : Set ForceNextPosition=spoofPos + SimulatedPosition=spoofPos
--   t=0.000  : FireServer Slash (server ghi nhận swing)
--   t=0.050  : Re-set ForceNextPosition + SimulatedPosition
--   t=0.100  : ReplicatorService.Update() tick #1 → gửi spoofPos lên server
--              server.actor.ServerPosition ← spoofPos
--   t=0.150  : Re-set ForceNextPosition + SimulatedPosition
--   t=0.200  : ReplicatorService.Update() tick #2 → confirm spoofPos
--   t=0.250  : FireServer Impact với hitPos tươi
--              server check: (spoofPos–hitPos).Magnitude = SpoofOffset ≤ Reach → HIT
-- ============================================================
local function AK_Fire(actor)
    local net = AK_FindNet()
    if not net then return false end
    local remote = AK_GetRemote()
    if not remote then return false end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return false end

    -- Target validation
    local char = rawget(actor, "Character") or (pcall(function() return actor.Character end) and actor.Character)
    if not char then return false end

    local part = char:FindFirstChild(AK.TargetPart)
               or char:FindFirstChild("Head")
               or char:FindFirstChild("UpperTorso")
               or char.PrimaryPart
    if not part then return false end

    local uid = GetUID(actor)
    if not uid then return false end

    -- Lấy hit position ban đầu
    local hitPos = part.Position

    -- spoofPos: đặt ngay cạnh target, cách hitPos đúng SpoofOffset
    -- → (spoofPos - hitPos).Magnitude = SpoofOffset = 1.5 < Reach 5–7 → PASS
    local spoofPos = hitPos + Vector3.new(0, AK.SpoofOffset, 0)

    -- Lưu SimulatedPosition thật để restore sau khi spoof kết thúc
    local realSimPos
    pcall(function() realSimPos = myActor.SimulatedPosition end)

    -- ── Spoof loop ──────────────────────────────────────────
    -- Chạy trong MeleeDelay + 0.35s để cover cả sau khi Impact fire
    -- ForceNextPosition priority > SimulatedPosition trong ReplicatorService.Update()
    -- SimulatedPosition làm fallback giữa các tick (khi FNP=nil do RS clear)
    -- CharacterController ghi đè SimulatedPosition mỗi frame → ta re-set 0.05s
    local spoofDeadline = tick() + AK.MeleeDelay + 0.35
    task.spawn(function()
        while tick() < spoofDeadline do
            pcall(function()
                myActor.ForceNextPosition = spoofPos
                myActor.SimulatedPosition = spoofPos
            end)
            task.wait(0.05)
        end
        -- Restore: CharacterController sẽ tự update SimulatedPosition về thật
        -- nhưng restore ngay để sạch hơn
        pcall(function()
            myActor.ForceNextPosition = nil
            if realSimPos then
                myActor.SimulatedPosition = realSimPos
            end
        end)
    end)

    -- ── Slash ───────────────────────────────────────────────
    -- Fire Slash ngay (t=0), trước khi chờ delay
    -- MeleeInventory._use(): FireServer("InventoryAction","Slash",n) tại t=0
    local n = math.random(1, 3)
    local encSlash = Encrypt({net._code, "InventoryAction", "Slash", n}, net)
    if encSlash then
        pcall(function() remote:FireServer(encSlash) end)
    end

    -- ── Wait MeleeDelay ─────────────────────────────────────
    -- Trong thời gian này:
    --   - ReplicatorService tick ít nhất 2 lần với ForceNextPosition=spoofPos
    --   - Server actor.ServerPosition ← spoofPos
    -- Đây cũng match với legit timing: Impact chỉ fire sau _delay từ Slash
    task.wait(AK.MeleeDelay)

    -- Re-read hitPos sau delay — target có thể đã di chuyển
    local freshPos = part.Position
    hitPos = freshPos

    -- Update spoofPos theo hitPos mới để đảm bảo distance check pass
    spoofPos = hitPos + Vector3.new(0, AK.SpoofOffset, 0)

    -- Re-force spoofPos một lần nữa trước Impact (double-ensure)
    pcall(function()
        myActor.ForceNextPosition = spoofPos
        myActor.SimulatedPosition = spoofPos
    end)

    -- ── Impact ──────────────────────────────────────────────
    -- MeleeInventory._use(): FireServer("InventoryAction","Impact",{x,y,z},uid,bodyPart)
    -- {x,y,z} = hitPos world space (từ MeleeInventoryReplicator.Impact raycast result)
    local encImpact = Encrypt(
        {net._code, "InventoryAction", "Impact",
         {hitPos.X, hitPos.Y, hitPos.Z}, uid, part.Name},
        net
    )
    if encImpact then
        pcall(function() remote:FireServer(encImpact) end)
    end

    return true
end

-- ============================================================
-- AK_Tick — sequential lock để tránh ForceNextPosition race
-- ============================================================
local function AK_Tick()
    if not AK.Enabled then return end
    if AK._lock then return end
    local now = tick()
    if now - AK._lastFire < AK.Interval then return end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return end

    -- Vị trí của mình
    local myPos
    pcall(function() myPos = myActor.Position end)
    if not myPos then
        local cam = workspace.CurrentCamera
        myPos = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
    end

    -- Scan enemies từ ReplicatorService.Actors (bảng keyed theo UID)
    local candidates = {}
    if rawget(ReplicatorService, "Actors") then
        for _, actor in pairs(ReplicatorService.Actors) do
            if type(actor) ~= "table" then continue end
            if actor == myActor then continue end

            -- Bỏ qua actor đã chết
            local alive = rawget(actor, "Alive")
            if alive == false then continue end

            -- Bỏ qua actor không có Character
            local char = rawget(actor, "Character")
            if not char then continue end

            -- Lấy vị trí
            local aPos
            pcall(function() aPos = actor.Position end)
            if not aPos then
                -- Fallback: ServerPosition
                pcall(function() aPos = actor.ServerPosition end)
            end
            if not aPos then
                local pp = char.PrimaryPart
                if pp then pcall(function() aPos = pp.Position end) end
            end
            if not aPos then continue end

            local d = (aPos - myPos).Magnitude
            if d <= AK.Range then
                candidates[#candidates + 1] = {Actor = actor, Dist = d}
            end
        end
    end

    if #candidates == 0 then return end

    -- Sort gần nhất trước
    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

    AK._lastFire = now
    AK._lock     = true

    local count = math.min(AK.BatchSize, #candidates)
    task.spawn(function()
        for i = 1, count do
            if not AK.Enabled then break end
            AK_Fire(candidates[i].Actor)
            -- Delay ngắn giữa các target để tránh spam server
            task.wait(0.05)
        end
        AK._lock = false
    end)
end

function AK.Start()
    if AK._running then return end
    AK._running = true
    AK._conn = Track(RunService.Heartbeat:Connect(AK_Tick))
    print("[LRM4] Started — Delay:", AK.MeleeDelay, "Offset:", AK.SpoofOffset, "Range:", AK.Range)
end

function AK.Stop()
    AK._running = false
    AK._lock    = false
    if AK._conn then
        pcall(function() AK._conn:Disconnect() end)
        AK._conn = nil
    end
    print("[LRM4] Stopped")
end

