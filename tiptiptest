            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.enabled = v end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_Box", {
        Text = "Box", Default = false,
        Callback = function(v)
            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.box = v end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_Name", {
        Text = "Name", Default = false,
        Callback = function(v)
            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.name = v end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_HP", {
        Text = "Health Bar", Default = false,
        Callback = function(v)
            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.healthBar = v end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_Dist", {
        Text = "Distance", Default = false,
        Callback = function(v)
            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.distance = v end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_Tracer", {
        Text = "Tracer", Default = false,
        Callback = function(v)
            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.tracer = v end
        end,
    })
    tab:AddSlider("ESP_"..kind.."_MaxDist", {
        Text = "Max Distance", Default = 1000, Min = 50, Max = 5000, Rounding = 0, Suffix = " st",
        Callback = function(v)
            local s = Combat.ESP and Combat.ESP.teamSettings and Combat.ESP.teamSettings[kind]
            if s then s.maxDistance = v; s.limitDistance = true end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_Chams", {
        Text = "Chams", Default = false,
        Callback = function(v)
            local c = Combat.ESP and Combat.ESP.chams and Combat.ESP.chams[kind]
            if c then c.enabled = v end
        end,
    })
    tab:AddColorPicker("ESP_"..kind.."_ChamsVis", {
        Default = Color3.fromRGB(0,255,100), Title = "Chams Visible Color", Transparency = 0.15,
        Callback = function(v)
            local c = Combat.ESP and Combat.ESP.chams and Combat.ESP.chams[kind]
            if c then c.visibleColor = v end
        end,
    })
    tab:AddToggle("ESP_"..kind.."_Skeleton", {
        Text = "Skeleton", Default = false,
        Callback = function(v)
            local a = Combat.ESP and Combat.ESP.advanced and Combat.ESP.advanced[kind]
            if a then a.skeleton = v end
        end,
    })
end

