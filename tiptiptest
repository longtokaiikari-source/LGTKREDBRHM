local function npcRoot(model)
    return model.PrimaryPart
        or model:FindFirstChild("Root")
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart")
end

local function npcFeetDrop(model, root)
    local lowest
    for _, name in { "LeftFoot", "RightFoot" } do
        local p = model:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            local y = p.Position.Y - p.Size.Y / 2
            lowest = lowest and math.min(lowest, y) or y
        end
    end
    if lowest then
        return math.clamp(root.Position.Y - lowest, 0, 6)
    end
    return root.Name == "HumanoidRootPart" and 3 or CONFIG.FollowFeetDrop
end

local function itemName(prompt)
    local text = prompt.ActionText or ""
    return (text:gsub("^[Pp]ick up ", ""))
end

local function getState(attachment, prompt)
    local uid = attachment.Name
    local s = state[uid]
    if not s then
        s = {
            name = itemName(prompt),
            consecutive = 0,
            decoyTries = 0,
            total = 0,
            nextTry = 0,
            firedAt = 0,
            distance = 0,
            viaDecoy = false,
            blocked = false,
        }
        s.conn = attachment.Destroying:Connect(function()

            if s.firedAt > 0 and os.clock() - s.firedAt <= CONFIG.ConfirmWindow then
                stats.picked += 1
                stats.maxDistance = math.max(stats.maxDistance, s.distance)
                totals[s.name] = (totals[s.name] or 0) + 1
                if s.viaDecoy then
                    stats.decoyPicked += 1
                    info.placedFails = 0
                    if placed then
                        placed.picked += 1
                    end
                end
                record(s.viaDecoy and "PICKED(decoy)" or "PICKED", s.name, uid, s.distance, s.total)
            end
        end)
        state[uid] = s
    end
    return s
end

local function fireOne(attachment, prompt, realDistance, viaDecoy)
    local s = getState(attachment, prompt)
    s.total += 1
    s.distance = realDistance
    s.firedAt = os.clock()
    s.viaDecoy = viaDecoy
    lastFire = s.firedAt
    debugLog("fire", s.name, attachment.Name, realDistance, viaDecoy and "decoy" or "direct")
    network:FireServer("InventoryPickUp", attachment.Name)
end

local function runDecoy(actor, target, all)
    local decoyPos = target.pos + CONFIG.DecoyOffset
    local now = os.clock()
    local batch = {}

    for _, c in all do
        local s = getState(c.attachment, c.prompt)
        if not s.blocked and now >= s.nextTry
            and (c.pos - decoyPos).Magnitude <= c.prompt.MaxActivationDistance - CONFIG.BatchMargin
        then
            if s.decoyTries >= CONFIG.MaxRetries then
                s.blocked = true
                s.decoyTries = 0
                stats.rejected += 1
                record("BLOCKED", s.name, c.attachment.Name, c.real, s.total)
            else
                table.insert(batch, c)
                if #batch >= CONFIG.MaxBatch then
                    break
                end
            end
        end
    end

    if #batch == 0 then
        return
    end

    stats.decoySessions += 1
    local before = stats.decoyPicked
    local deadline = os.clock() + CONFIG.DecoyMaxTime
    event(("HOP #%d -> %d item(s), %.1f studs away"):format(stats.decoySessions, #batch, target.real))

    local function arm()
        actor.ForceNextPosition = decoyPos
    end

    arm()
    while actor.ForceNextPosition ~= nil and os.clock() < deadline do
        task.wait()
    end
    arm()
    task.wait(CONFIG.DecoyDelay)

    for _, c in batch do
        if os.clock() > deadline or env.AutoPickupToken ~= token then
            break
        end
        if actor.ForceNextPosition == nil then
            arm()
        end
        local s = getState(c.attachment, c.prompt)
        s.decoyTries += 1
        s.nextTry = os.clock() + CONFIG.RetryDelay
        fireOne(c.attachment, c.prompt, c.real, true)
        task.wait(CONFIG.PickupSpacing)
    end

    task.wait(CONFIG.DecoyDelay)
    actor.ForceNextPosition = nil

    task.wait(0.5)
    if stats.decoyPicked == before then
        info.failStreak += 1
        if info.failStreak >= CONFIG.MaxDecoyFailures then
            CONFIG.DecoyEnabled = false
            event(("HOP DECOYS DISABLED: %d sessions in a row picked nothing, the server is rejecting them"):format(info.failStreak))
        end
    else
        info.failStreak = 0
    end
end

local function startDecoy(target, all)
    local actor = replicator and replicator.LocalActor
    if not actor or actor.Alive == false or actor.Downed or actor.ForceNextPosition ~= nil then
        return false
    end
    busy = true
    info.busy = true
    task.spawn(function()
        local ok, err = pcall(runDecoy, actor, target, all)
        pcall(function()
            actor.ForceNextPosition = nil
        end)
        if not ok then
            event("HOP ERROR " .. tostring(err))
        end
        nextDecoy = os.clock() + CONFIG.DecoyCooldown
        busy = false
        info.busy = false
    end)
    return true
end

local function leftText()
    if not placed then
        return "-"
    end
    if placed.expires == math.huge then
        return "until recalled"
    end
    return ("%ds left"):format(math.max(0, math.floor(placed.expires - os.clock())))
end

local function aimPoint(skipInvisible)
    local ray
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        local viewport = camera.ViewportSize
        ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
    else
        local m = UserInputService:GetMouseLocation()
        ray = camera:ViewportPointToRay(m.X, m.Y)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = { camera }
    if localPlayer.Character then
        table.insert(ignore, localPlayer.Character)
    end
    local actor = replicator and replicator.LocalActor
    if actor and typeof(actor.Character) == "Instance" then
        table.insert(ignore, actor.Character)
    end
    params.FilterDescendantsInstances = ignore

    local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    if skipInvisible then

        local function belongsToNpc(inst)
            local m = inst:FindFirstAncestorOfClass("Model")
            while m do
                if CONFIG.NpcNames[m.Name] then
                    return true
                end
                m = m:FindFirstAncestorOfClass("Model")
            end
            return false
        end
        for _ = 1, 8 do
            if not (result and result.Instance.Transparency >= 1 and not belongsToNpc(result.Instance)) then
                break
            end
            table.insert(ignore, result.Instance)
            params.FilterDescendantsInstances = ignore
            result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
        end
    end
    return result and result.Position or nil, result and result.Instance or nil
end

local function buildGhost(feet)
    local model = Instance.new("Model")
    model.Name = "AutoPickupDecoy"

    local function part(size, cf, shape)
        local p = Instance.new("Part")
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Material = Enum.Material.ForceField
        p.Color = CONFIG.GhostColor
        p.Transparency = 0.55
        if shape then
            p.Shape = shape
        end
        p.Size = size
        p.CFrame = cf
        p.Parent = model
        return p
    end

    local upright = CFrame.Angles(0, 0, math.rad(90))
    part(Vector3.new(3.2, 1.9, 1.9), CFrame.new(feet + Vector3.new(0, 2.2, 0)) * upright, Enum.PartType.Cylinder)
    local head = part(Vector3.new(1.3, 1.3, 1.3), CFrame.new(feet + Vector3.new(0, 4.5, 0)), Enum.PartType.Ball)

    local diameter = CONFIG.GhostRadius * 2
    local ring = part(Vector3.new(0.1, diameter, diameter), CFrame.new(feet + Vector3.new(0, 0.1, 0)) * upright, Enum.PartType.Cylinder)
    ring.Material = Enum.Material.Neon
    ring.Transparency = 0.75

    local highlight = Instance.new("Highlight")
    highlight.Adornee = model
    highlight.FillColor = CONFIG.GhostColor
    highlight.FillTransparency = 0.65
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.fromOffset(190, 34)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0.4
    label.Text = "decoy"
    label.Parent = billboard

    model.Parent = camera
    return model, label
end

local function teardownDecoy(reason)
    following = false
    if hold then
        hold:Disconnect()
        hold = nil
    end
    if placed then
        if placed.model then
            placed.model:Destroy()
        end
        placed = nil
    end
    local actor = replicator and replicator.LocalActor
    if actor then
        pcall(function()
            actor.ForceNextPosition = nil
        end)
    end
    if reason then
        event("DECOY " .. reason)
    end
end

local function stopDecoy(reason, instant)
    following = false
    local actor = replicator and replicator.LocalActor
    if placed and hold and not instant and not placed.returning
        and CONFIG.DecoyWalkSpeed ~= math.huge
        and actor and actor.Alive ~= false and not actor.Downed
    then
        placed.returning = true
        if placed.model then
            placed.model:Destroy()
            placed.model = nil
            placed.label = nil
        end
        event("DECOY RECALLED: " .. (reason or "recalled") .. ", walking the reported position back")
        return
    end
    teardownDecoy(reason and ("RECALLED: " .. reason) or nil)
end

local function placeDecoyAt(feet, restoring, noSave)
    if not replicator then
        event("cannot drop a decoy: replicator not found")
        return
    end
    local actor = replicator.LocalActor
    if not actor or actor.Alive == false or actor.Downed then
        event("cannot drop a decoy while dead or downed")
        return
    end
    if busy then
        event("a hop session is running, try again in a second")
        return
    end

    local real = getOrigin()
    local distance = real and (feet - real).Magnitude or 0
    local ignoreDistance = (restoring and CONFIG.RestoreIgnoresDistance) or (noSave and CONFIG.FollowIgnoresDistance)
    if distance > CONFIG.MaxDecoyDistance and not ignoreDistance then
        event(("decoy refused: %.0f studs away, max is %d"):format(distance, CONFIG.MaxDecoyDistance))
        return
    end

    local startPos = placed and placed.reported or getOrigin()
    teardownDecoy()

    if not noSave and not (CONFIG.KeepFirstSpot and savedDecoy) then
        savedDecoy = { feet = feet }
        event("saved this spot for remove / restore")
    end

    local model, label = buildGhost(feet)
    local goal = feet + CONFIG.DecoyOffset
    placed = {
        feet = feet,
        goal = goal,
        reported = startPos or goal,
        expires = os.clock() + CONFIG.PlacedMaxTime,
        model = model,
        label = label,
        picked = 0,
        returning = false,
    }
    info.placedFails = 0
    stats.placedDrops += 1

    local nearby, nearest = 0, math.huge
    for _, child in dropContainer:GetChildren() do
        if child:IsA("Attachment") then
            local prompt = child:FindFirstChild("PickUp")
            if prompt and prompt:IsA("ProximityPrompt") then
                local d = (child.WorldPosition - goal).Magnitude
                nearest = math.min(nearest, d)
                if d <= prompt.MaxActivationDistance - CONFIG.BatchMargin then
                    nearby += 1
                end
            end
        end
    end
    event(("DECOY %s %.1f studs away, %d item(s) in pickup range of it (nearest %.1f studs)"):format(
        restoring and "RESTORED" or "DROPPED", distance, nearby, nearest == math.huge and -1 or nearest))
    if nearby == 0 and not noSave then
        event("nothing is in pickup range of the ghost, aim at the ground right next to the items")
    end

    hold = RunService.Heartbeat:Connect(function(dt)
        if env.AutoPickupToken ~= token then
            teardownDecoy()
            return
        end
        local a = replicator.LocalActor
        if not placed or not a then
            return
        end
        if a.Alive == false or a.Downed then
            teardownDecoy("RECALLED: you died or were downed")
            return
        end

        local here = getOrigin()
        local target = placed.goal
        if placed.returning then
            target = here or placed.reported
        elseif os.clock() > placed.expires then
            stopDecoy("expired")
        elseif CONFIG.RecallWhenFar and here and (here - placed.reported).Magnitude > CONFIG.MaxDecoyDistance * 1.5 then
            stopDecoy("you moved too far from it")
        end
        if not placed then
            return
        end

        if following and not placed.returning then
            local npc = selectedNpc
            local root = npc and npc.Parent and npcRoot(npc)
            if root then
                local newFeet = root.Position - Vector3.new(0, selectedFeetDrop, 0) + CONFIG.FollowOffset
                if placed.model then
                    placed.model:PivotTo(placed.model:GetPivot() + (newFeet - placed.feet))
                end
                placed.feet = newFeet
                placed.goal = newFeet + CONFIG.DecoyOffset
                target = placed.goal
            end
        end

        local delta = target - placed.reported
        local speed = CONFIG.DecoyWalkSpeed
        if speed == math.huge or delta.Magnitude <= speed * dt then
            placed.reported = target
        else
            placed.reported = placed.reported + delta.Unit * (speed * dt)
        end

        if placed.returning and here and (placed.reported - here).Magnitude < 1 then
            teardownDecoy("returned, your real position resumed")
            return
        end

        a.ForceNextPosition = placed.reported
    end)
end

local function dropDecoy()
    local feet = aimPoint()
    if not feet then
        event("no surface under the crosshair, aim at the ground or a wall")
        return
    end
    placeDecoyAt(feet, false)
end

local function restoreDecoy()
    if placed and not placed.returning then
        event("decoy is already placed")
        return
    end
    if not savedDecoy then
        event("no saved decoy yet, drop one first")
        return
    end

    placeDecoyAt(savedDecoy.feet, true)
end

local function toggleDecoy()
    if placed and not placed.returning then
        stopDecoy("removed (saved, press again to restore it)")
    else
        restoreDecoy()
    end
end

local streamBusy = false
local streamWarned = false

local function requestStream()
    if streamBusy or not placed or placed.returning then
        return
    end
    streamBusy = true
    local center = placed.goal
    task.spawn(function()
        local ok, err = pcall(function()
            localPlayer:RequestStreamAroundAsync(center, CONFIG.StreamTimeout)
        end)
        if not ok and not streamWarned then
            streamWarned = true
            event("stream request failed: " .. tostring(err) .. " (the map may already be fully loaded)")
        end
        streamBusy = false
    end)
end

local function noteDecoyFail(s)
    info.placedFails += 1
    event(("no response for %s at the placed decoy (%d/%d)"):format(s.name, info.placedFails, CONFIG.MaxDecoyFailures))
    if info.placedFails >= CONFIG.MaxDecoyFailures then
        if CONFIG.RecallOnNoResponse then
            stopDecoy("no server response (it may reject the spoofed position, or your inventory is full)")
        else
            event(("%d unanswered pickups in a row; decoy kept active (it may be rejected, or your inventory is full)"):format(info.placedFails))
            info.placedFails = 0
        end
    end
end

