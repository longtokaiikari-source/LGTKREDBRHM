return {
    Start=Start, Stop=Stop, Config=CFG,
    _v_u_1=function() return _v_u_1 end,
    _uid=function() return _localUID end,
    _spam=SpoofSpam,
    _scan=ScanTargets,
    _slash=FireSlash,
    _impact=FireImpact,
}
