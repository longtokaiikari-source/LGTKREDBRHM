local meleeConfig
do
    local ok, result = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Configs.Melee)
    end)
    if ok and type(result) == "table" then
        meleeConfig = result
    end
end

local function equippedMelee()
    local a = replicator and replicator.LocalActor
    if not a then
        return nil
    end
    local ok, item = pcall(function()
        local eq = a._equipped
        return eq and a._inventory and a._inventory[eq]
    end)
    if not (ok and type(item) == "table") then
        return nil
    end
    local okb, build = pcall(function()
        return item._build
    end)
    if not (okb and build) then
        return nil
    end
    local cfg = meleeConfig and meleeConfig[build]
    if meleeConfig and not cfg then
        return nil
    end
    return item, (cfg and cfg.Time) or CONFIG.AuraTime, (cfg and cfg.Delay) or CONFIG.AuraDelay, (cfg and cfg.Reach) or CONFIG.AuraReach
end

local function setAuraStatus(text)
    if auraStats.status ~= text then
        auraStats.status = text
        event("AURA " .. text)
    end
end

local function reportedPosition()
    if placed and not placed.returning then
        return placed.reported
    end
    return getOrigin()
end

local function targetPart(uid)
    local t = replicator.Actors[uid]
    if not t or t.Alive == false then
        return nil, nil
    end
    local char = t.Character
    local part = typeof(char) == "Instance" and char:FindFirstChild(CONFIG.AuraPart)
    return part or nil, t
end

local function auraStep()
    local me = replicator and replicator.LocalActor
    if not me or me.Alive == false or me.Downed then
        setAuraStatus("paused: you are dead or downed")
        return
    end
    if not selectedUid then
        setAuraStatus(selectedNpc and "paused: target is not a networked actor (no UID)" or "waiting for a target (hover one, press " .. CONFIG.SelectKey.Name .. ")")
        return
    end
    local part, target = targetPart(selectedUid)
    if not part then
        setAuraStatus(target and "paused: target has no " .. CONFIG.AuraPart or "paused: target is dead or gone")
        return
    end

    local item, swingTime, swingDelay, reach = equippedMelee()
    if not item and CONFIG.AuraNeedsMelee then
        setAuraStatus("paused: equip a melee weapon")
        return
    end
    swingTime, swingDelay, reach = swingTime or CONFIG.AuraTime, swingDelay or CONFIG.AuraDelay, reach or CONFIG.AuraReach

    if CONFIG.AuraAutoFollow and not following and selectedNpc and os.clock() >= auraFollowAt then
        auraFollowAt = os.clock() + 2
        toggleFollow()
    end

    local from = reportedPosition()
    if not from then
        return
    end
    local dist = (part.Position - from).Magnitude
    if dist > reach - CONFIG.AuraReachMargin then
        setAuraStatus(("closing in on the target's %s (reach %.1f)"):format(CONFIG.AuraPart, reach))
        return
    end

    local now = os.clock()
    if now < auraNext then
        return
    end
    auraNext = now + swingTime
    setAuraStatus(("swinging at %s (%s), reach %.1f"):format(CONFIG.AuraPart, selectedNpc and selectedNpc.Name or "?", reach))

    local uid = selectedUid
    local n = math.random(1, 3)
    network:FireServer("InventoryAction", "Slash", n)
    if CONFIG.AuraAnimate and item and item.Slash then
        pcall(item.Slash, item, n)
    end

    task.delay(swingDelay, function()
        if env.AutoPickupToken ~= token or not auraOn then
            return
        end
        local p2 = targetPart(uid)
        local f2 = reportedPosition()
        if not p2 or not f2 or (p2.Position - f2).Magnitude > reach - CONFIG.AuraReachMargin + 0.3 then
            return
        end

        local dir = f2 - p2.Position
        local hit = p2.Position + (dir.Magnitude > 0 and dir.Unit or Vector3.zero) * (p2.Size.X / 2)
        network:FireServer("InventoryAction", "Impact", { hit.X, hit.Y, hit.Z }, uid, p2.Name)
        auraStats.swings += 1
        debugLog("impact", uid, p2.Name, (p2.Position - f2).Magnitude)
        if auraStats.swings % 10 == 0 then
            event(("AURA %d swings sent"):format(auraStats.swings))
        end
    end)
end

local function toggleAura()
    auraOn = not auraOn
    auraStats.status = ""
    event("melee aura " .. (auraOn and "ON" or "OFF"))
end
env.AutoPickup.Aura = toggleAura

local function scan()
    if busy then
        return
    end

    local real = getOrigin()
    if not real then
        return
    end

    local origin = real
    if placed then
        origin = placed.reported
    end

    local seen = {}
    local all = {}

    for _, child in dropContainer:GetChildren() do
        if child:IsA("Attachment") then
            local prompt = child:FindFirstChild("PickUp")
            if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                seen[child.Name] = true
                local pos = child.WorldPosition
                table.insert(all, {
                    attachment = child,
                    prompt = prompt,
                    pos = pos,
                    distance = (pos - origin).Magnitude,
                    real = (pos - real).Magnitude,
                })
            end
        end
    end

    table.sort(all, function(a, b)
        return a.distance < b.distance
    end)

    info.prompts = #all
    info.nearest = all[1] and all[1].distance or -1

    local now = os.clock()
    for _, c in all do
        local s = getState(c.attachment, c.prompt)
        local normal = c.prompt.MaxActivationDistance
        local limit = placed and (normal - CONFIG.BatchMargin) or normal

        if s.blocked and c.distance <= limit then
            s.blocked = false
            s.consecutive = 0
            s.decoyTries = 0
            s.nextTry = 0
        end

        if not s.blocked and now >= s.nextTry then
            if c.distance <= limit then
                if now - lastFire >= CONFIG.PickupSpacing then
                    s.consecutive += 1
                    if s.consecutive >= CONFIG.MaxRetries then
                        s.consecutive = 0
                        s.nextTry = now + CONFIG.BackoffDelay
                        if placed then
                            noteDecoyFail(s)
                        end
                    else
                        s.nextTry = now + CONFIG.RetryDelay
                    end
                    fireOne(c.attachment, c.prompt, c.real, placed ~= nil)
                end
                break
            elseif not placed and CONFIG.DecoyEnabled and c.distance <= CONFIG.MaxDecoyDistance and now >= nextDecoy then
                if startDecoy(c, all) then
                    break
                end
            end
        end
    end

    for uid, s in state do
        if not seen[uid] then
            if s.conn then
                s.conn:Disconnect()
            end
            state[uid] = nil
        end
    end
end

