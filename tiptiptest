-- ════════════════════════════════════════════════════════════
--  SERVICES & NETWORK
-- ════════════════════════════════════════════════════════════
local Players = game:GetService("Players")
local UIS     = game:GetService("UserInputService")
local lp      = Players.LocalPlayer

local Network = shared and shared.import and shared.import("network")
assert(Network, "[v11] network import failed")

-- ════════════════════════════════════════════════════════════
--  v_u_1 DETECTION (unreliable remote — upvalue of RS.Update)
-- ════════════════════════════════════════════════════════════
local _v_u_1    = nil
local _vu1_how  = nil

local function HasFUS(o)
    if type(o) ~= "table" and type(o) ~= "userdata" then return false end
    local ok, f = pcall(function() return o.FireUnreliableServer end)
    return ok and type(f) == "function"
end

local function FindVU1()
    if _v_u_1 then return true end

    -- L1: Network itself (some builds expose it)
    if HasFUS(Network) then _v_u_1=Network; _vu1_how="net_meta"; return true end

    -- L2: debug.getupvalues on RS.Update
    local _g = (debug and type(debug.getupvalues)=="function" and debug.getupvalues)
    local _req = shared and shared.import and pcall(shared.import,"require") and
                 select(2, pcall(shared.import, "require"))
    local RS = _req and pcall(_req,"ReplicatorService") and
               select(2, pcall(_req,"ReplicatorService"))

    if _g and RS then
        local upFn = rawget(RS,"Update")
        if type(upFn)=="function" then
            local ok,ups = pcall(_g,upFn)
            if ok and type(ups)=="table" then
                for _,v in pairs(ups) do
                    if HasFUS(v) and v~=Network then
                        _v_u_1=v; _vu1_how="upval_rs"; return true
                    end
                end
            end
        end
        -- L3: RS fields scan
        for _,v in pairs(RS) do
            if HasFUS(v) and v~=Network then _v_u_1=v; _vu1_how="rs_field"; return true end
        end
    end

    -- L4: GC / registry scan
    local ok3,reg = pcall(function() return debug.getregistry() end)
    if ok3 and type(reg)=="table" then
        for _,v in pairs(reg) do
            if HasFUS(v) and v~=Network then _v_u_1=v; _vu1_how="gc"; return true end
        end
    end

    return false
end

-- ════════════════════════════════════════════════════════════
--  LOCAL ACTOR HELPERS
-- ════════════════════════════════════════════════════════════
local _localUID   = nil
local _localActor = nil

local function RefreshLocalActor()
    local ok,cs = pcall(function()
        return shared.import("require")("ClientService")
    end)
    if ok and cs and cs.LocalClient then
        _localActor = cs.LocalClient.LocalActor or cs.LocalClient._localActor
        _localUID   = cs.LocalClient.UID or cs.LocalClient._uid
            or (_localActor and (rawget(_localActor,"UID") or rawget(_localActor,"_uid")))
    end
    if not _localUID then
        -- fallback: character attribute
        local char = lp.Character
        if char then
            _localUID = char:GetAttribute("UID") or char:GetAttribute("ActorUID")
        end
    end
end

local function ActorField(k, default)
    if not _localActor then return default end
    local ok,v = pcall(function() return _localActor[k] end)
    return (ok and v) or default
end

-- ════════════════════════════════════════════════════════════
--  POSITION SPAM  (bypass RS 100ms throttle)
-- ════════════════════════════════════════════════════════════
local function SpoofSpam(pos, count)
    if not _v_u_1 or not _localUID then return 0 end
    count = count or CFG.SpamCount

    -- Also set ForceNextPosition so RS.Update() sends it on its own next tick (backup)
    if _localActor then
        pcall(function()
            _localActor.ForceNextPosition = pos
            _localActor.SimulatedPosition  = pos
        end)
    end

    -- Direct spam — no throttle since we're calling v_u_1 directly, not via RS.Update
    local ori  = ActorField("Orientation", 0)
    local spr  = ActorField("Sprinting",   false)
    local hs   = ActorField("HeightState", 0)
    local cx   = ActorField("CameraX",     0)
    local cy   = ActorField("CameraY",     0)
    local lg   = ActorField("LeanGoal",    0)
    local pl   = ActorField("Platform",    false)
    local tr   = ActorField("TeleportRevision", 0)

    local sent = 0
    for _ = 1, count do
        local ok = pcall(function()
            _v_u_1:FireUnreliableServer(
                "ReplicateMovement", _localUID,
                pos.X, pos.Y, pos.Z,
                ori, spr, hs, cx, cy, lg, pl, tr
            )
        end)
        if ok then sent = sent + 1 end
    end
    return sent
end

-- ════════════════════════════════════════════════════════════
--  FIRE HELPERS  (exact MeleeInventory.lua format)
-- ════════════════════════════════════════════════════════════
local function FireSlash(animNum)
    -- matches: v_u_2:FireServer("InventoryAction","Slash",animNum)
    pcall(function() Network:FireServer("InventoryAction","Slash",animNum) end)
end

local function FireImpact(hitPos, uid, part)
    -- matches: v_u_2:FireServer("InventoryAction","Impact",v_u_7(hitPos),uid,part)
    -- v_u_7 = vector3toTable = {x,y,z}
    local tbl = {x=hitPos.X, y=hitPos.Y, z=hitPos.Z}
    pcall(function() Network:FireServer("InventoryAction","Impact",tbl,uid,part) end)
end

-- ════════════════════════════════════════════════════════════
--  NPC SCANNER
-- ════════════════════════════════════════════════════════════
local function ScanTargets(maxRange)
    local out = {}
    local myPos = Vector3.new(0,0,0)
    local char = lp.Character
    local hrp0 = char and char:FindFirstChild("HumanoidRootPart")
    if hrp0 then myPos = hrp0.Position end

    -- helper: add a character model if it qualifies
    local function tryAdd(model)
        if model == char then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local hrp = model:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        if (hrp.Position - myPos).Magnitude > maxRange then return end

        -- UID resolution — try every known location
        local uid = model:GetAttribute("UID")
               or model:GetAttribute("ActorUID")
               or model:GetAttribute("_uid")
        if not uid then
            -- scan model children for UID property
            for _, child in ipairs(model:GetChildren()) do
                local ok2,v2 = pcall(function() return child.UID end)
                if ok2 and v2 and type(v2)=="string" then uid=v2; break end
                local ok3,v3 = pcall(function() return rawget(child,"UID") end)
                if ok3 and v3 then uid=v3; break end
            end
        end
        if not uid then uid = model.Name .. tostring(math.floor(hrp.Position.X)) end

        out[#out+1] = {uid=uid, pos=hrp.Position, model=model}
    end

    -- player characters
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            pcall(tryAdd, p.Character)
        end
    end
    -- workspace NPCs (zombies, bots)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            pcall(tryAdd, obj)
        end
    end
    return out
end

-- ════════════════════════════════════════════════════════════
--  WEAPON CONFIG
-- ════════════════════════════════════════════════════════════
local function GetWepCfg()
    local build = nil
    -- try InventoryService.Equipped
    local ok,inv = pcall(function() return shared.import("require")("InventoryService") end)
    if ok and inv then
        local eq = rawget(inv,"Equipped") or inv.Equipped
        if eq and eq.Handler then
            build = rawget(eq.Handler,"_build") or eq.Handler._build
        end
    end
    -- fallback: equipped tool
    if not build then
        local c = lp.Character
        if c then
            for _,t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") then
                    build = t:GetAttribute("Build") or t:GetAttribute("Variant") or t.Name
                    break
                end
            end
        end
    end
    local cfg = (build and MELEE_CFG[build]) or {Delay=0.25,Time=0.50,Reach=5}
    return cfg, build or "?"
end

-- ════════════════════════════════════════════════════════════
--  MAIN CYCLE
-- ════════════════════════════════════════════════════════════
local function RunCycle()
    local wCfg, wName = GetWepCfg()
    local delay = CFG.DelayOverride or wCfg.Delay
    local timer = CFG.TimerOverride or wCfg.Time

    local targets = ScanTargets(CFG.AuraRadius)
    if #targets == 0 then
        if CFG.Debug then print("[v11] no targets") end
        return timer
    end

    -- Centroid of all targets
    local cx2,cy2,cz2 = 0,0,0
    for _,t in ipairs(targets) do
        cx2=cx2+t.pos.X; cy2=cy2+t.pos.Y; cz2=cz2+t.pos.Z
    end
    local n = #targets
    local centroid = Vector3.new(cx2/n, cy2/n, cz2/n)

    if CFG.Debug then
        print(string.format("[v11] wep=%s | targets=%d | delay=%.2f timer=%.2f",
            wName, n, delay, timer))
    end

    -- 1) Pre-Slash spam: flood server with centroid position
    local s1 = SpoofSpam(centroid, CFG.SpamCount)
    if CFG.Debug then print("[v11] pre-spam sent="..s1) end

    -- 2) Slash immediately (no wait — spam already in flight)
    local anim = math.random(1,3)
    FireSlash(anim)
    if CFG.Debug then print("[v11] Slash(anim="..anim..")") end

    -- 3) Mid-delay spam (halfway through delay window)
    --    Spawned so Slash fires without waiting
    local halfDelay = delay * 0.5
    task.spawn(function()
        task.wait(halfDelay)
        SpoofSpam(centroid, CFG.SpamCount2)
    end)

    -- 4) Wait exact Delay from Melee.lua
    task.wait(delay)

    -- 5) Burst Impact all targets
    local hits = 0
    for _, tgt in ipairs(targets) do
        local hitPos = tgt.pos + CFG.PartOffset
        FireImpact(hitPos, tgt.uid, CFG.BodyPart)
        hits = hits + 1
    end
    if CFG.Debug then print("[v11] Impact burst x"..hits) end

    -- 6) Remaining wait before next cycle
    local remaining = math.max(0.05, timer - delay)
    return remaining
end

-- ════════════════════════════════════════════════════════════
--  LOOP CONTROL
-- ════════════════════════════════════════════════════════════
local _running = false
local _enabled = false

local function Start()
    if _running then print("[v11] already running"); return end
    _running = true
    _enabled = true

    RefreshLocalActor()

    print("[v11] detecting v_u_1...")
    if FindVU1() then
        print("[v11] v_u_1 OK via "..(_vu1_how or "?"))
    else
        print("[v11] WARN: v_u_1 not found — position spam disabled")
    end
    if not _localUID then
        print("[v11] WARN: localUID not found — spoof will skip")
    end

    print("[v11] AuraKill ON | radius="..CFG.AuraRadius)
    task.spawn(function()
        while _enabled do
            local ok, wait_t = pcall(RunCycle)
            if not ok then
                print("[v11] cycle err: "..tostring(wait_t))
                wait_t = 0.5
            end
            task.wait(wait_t or 0.5)
        end
        _running = false
        print("[v11] AuraKill OFF")
    end)
end

local function Stop()
    _enabled = false
end

-- ════════════════════════════════════════════════════════════
--  KEYBINDS  F=toggle | G=single test | H=status
-- ════════════════════════════════════════════════════════════
UIS.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == Enum.KeyCode.F then
        if _enabled then Stop() else Start() end

    elseif inp.KeyCode == Enum.KeyCode.G then
        -- single cycle test
        RefreshLocalActor()
        FindVU1()
        print("[v11] TEST CYCLE")
        local ok, w = pcall(RunCycle)
        if not ok then print("[v11] err: "..tostring(w)) end

    elseif inp.KeyCode == Enum.KeyCode.H then
        -- status dump
        print(string.format("[v11] status: running=%s | v_u_1=%s(%s) | uid=%s",
            tostring(_enabled),
            tostring(_v_u_1 ~= nil),
            _vu1_how or "none",
            tostring(_localUID)
        ))
    end
end)

