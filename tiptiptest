            lblMode.TextColor3 = AK._directMode
                and Color3.fromRGB(65, 210, 100)
                or  Color3.fromRGB(210, 180, 65)
        else
            AK.Stop()
            toggleBtn.Text       = "[ OFF ]  F3 — Toggle Aura Kill"
            toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
            lblStatus.Text       = "Status  : OFF"
            lblStatus.TextColor3 = Color3.fromRGB(210, 65, 65)
        end

    elseif kc == Enum.KeyCode.F1 then
        AK.Stagger = math.max(0.008, AK.Stagger - 0.008)
        lblSpeed.Text = fmtSpeed()
    elseif kc == Enum.KeyCode.F2 then
        AK.Stagger = math.min(0.20, AK.Stagger + 0.008)
        lblSpeed.Text = fmtSpeed()

    elseif kc == Enum.KeyCode.F4 then
        AK.Range = math.max(5, AK.Range - 50)
        lblRange.Text = fmtRange()
    elseif kc == Enum.KeyCode.F5 then
        AK.Range = math.min(9999, AK.Range + 50)
        lblRange.Text = fmtRange()

    elseif kc == Enum.KeyCode.F6 then
        AK.MeleeDelay = math.max(0.10, AK.MeleeDelay - 0.05)
        lblDelay.Text = fmtDelay()
    elseif kc == Enum.KeyCode.F7 then
        AK.MeleeDelay = math.min(1.0, AK.MeleeDelay + 0.05)
        lblDelay.Text = fmtDelay()

    elseif kc == Enum.KeyCode.F8 then
        AK.BatchSize = math.max(1, AK.BatchSize - 5)
        lblRange.Text = fmtRange()
        lblSpeed.Text = fmtSpeed()
    elseif kc == Enum.KeyCode.F9 then
        AK.BatchSize = math.min(50, AK.BatchSize + 5)
        lblRange.Text = fmtRange()
        lblSpeed.Text = fmtSpeed()

    elseif kc == Enum.KeyCode.F10 then
        AK.MultiHit = AK.MultiHit == 1 and 2 or 1
        lblSpeed.Text = fmtSpeed()
        print("[LRM8] MultiHit →", AK.MultiHit .. "x")
    end
end))

