-- ============================================================================
-- Standalone Melee Aura Test — far-kill version. No Linoria, no tabs.
--
-- Two mechanisms combined, both confirmed against real source:
-- 1. Cipher (ported from the confirmed-working AuraKill module,
--    tipmobile_1.txt lines 2754-2956):
--      RemoteEvent:FireServer(netEncode(JSONEncode({net._code,...}),net._key))
--    Plain unencrypted FireServer calls don't get accepted — this was the
--    piece missing from every earlier attempt.
-- 2. Report-position trick (confirmed against ReplicatorService.lua /
--    CharacterController.lua from the actual game): right before an Impact
--    fires, set LocalActor.SimulatedPosition and .ForceNextPosition to the
--    target's position — NOT CFrame. ReplicatorService.lua's ReplicateMovement
--    packet reads ForceNextPosition-or-SimulatedPosition, so the server is
--    told the actor is standing next to the target. CFrame is what the
--    character model actually renders from, and it's never touched, so
--    nothing visibly moves. The fields are restored right after the Impact
--    is sent.
--
-- Press B or click the button to toggle.
-- ============================================================================

local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local HttpService=game:GetService("HttpService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local LocalPlayer=Players.LocalPlayer

local AuraKill={
    Enabled=false,
    Range=80,
    Interval=0,
    BatchSize=10,
    TargetPart="Head",
    _net=nil,
    _remote=nil,
    _lastFire=0,
}

local A={swings=0,impacts=0,status="idle",log={},targetName="-"}
local function logEvent(text)
    local line=("[%s] %s"):format(os.date("%H:%M:%S"),text)
    A.log[#A.log+1]=line
    if #A.log>12 then table.remove(A.log,1) end
end
local function setStatus(text)
    if A.status~=text then A.status=text;logEvent(text) end
end

-- ---------------------------------------------------------------------------
-- Find network object: table with _code (UUID) + _key (array of 5 numbers)
-- + _events. Ported from AK_FindNet exactly.
-- ---------------------------------------------------------------------------
local _netNextScan=0
local function AK_FindNet()
    if AuraKill._net then return AuraKill._net end
    local now=os.clock()
    if now<_netNextScan then return nil end -- don't hammer the GC scan every tick
    _netNextScan=now+2

    -- Method 1: shared.import("network")
    if shared and type(shared.import)=="function" then
        local ok,net=pcall(function() return shared.import("network") end)
        if ok and net and rawget(net,"_key") and rawget(net,"_code") then
            AuraKill._net=net
            logEvent("net via shared.import, code: "..tostring(net._code):sub(1,8))
            return net
        elseif not ok then
            logEvent("shared.import failed: "..tostring(net))
        elseif net then
            logEvent("shared.import('network') returned something without _key/_code")
        end
    else
        logEvent("shared.import not available on this executor")
    end

    -- Method 2: GC scan
    local gok,gc=pcall(function() return type(filtergc)=="function" and filtergc("table") or getgc(true) end)
    if gok and gc then
        for _,v in pairs(gc) do
            if type(v)=="table" then
                local k=rawget(v,"_key")
                local co=rawget(v,"_code")
                local ev=rawget(v,"_events")
                if type(k)=="table" and #k>=5
                    and type(co)=="string" and co:match("^%x+%-%x+%-%x+%-%x+%-%x+$")
                    and type(ev)=="table" then
                    local allNums=true
                    for _,n in ipairs(k) do if type(n)~="number" then allNums=false;break end end
                    if allNums then
                        AuraKill._net=v
                        logEvent("net via GC, code: "..co:sub(1,8))
                        return v
                    end
                end
            end
        end
        logEvent(("GC scan: %d tables, no match"):format((function()
            local n=0;for _ in pairs(gc) do n=n+1 end;return n
        end)()))
    else
        logEvent("GC scan unavailable: "..tostring(gc))
    end
    return nil
end

local function AK_GetRemote()
    if AuraKill._remote and AuraKill._remote.Parent then return AuraKill._remote end
    local ev=ReplicatedStorage:FindFirstChild("Events")
    if ev then
        local re=ev:FindFirstChild("RemoteEvent")
        if re then AuraKill._remote=re;return re end
    end
    for _,v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then AuraKill._remote=v;return v end
    end
    return nil
end

-- netEncode — ported exactly from AK_NetEncode (verified byte-for-byte against
-- real Lua 5.4 in prior testing).
local function AK_NetEncode(jsonStr,key)
    local result=""
    for i=1,#jsonStr do
        local ki=i%4
        local kval=key[ki+1]
        local nb=(string.byte(jsonStr,i)-32+kval)%95+32
        result=result..string.char(nb)
    end
    local firstByte=string.byte(jsonStr,1)
    for v24=1,key[5] do
        local v26=tostring(v24)
        local v27=firstByte-string.byte(v26,1)
        result=result..string.char(v27)
    end
    return result
end

local function AK_Encrypt(data,net)
    local ok,raw=pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or not raw then return nil end
    return AK_NetEncode(raw,net._key)
end

-- Actor UID: UUID string. Tries named fields first, falls back to scanning
-- for any UUID-shaped string value on the actor.
local function AK_GetUID(actor)
    for _,field in ipairs({"UID","_id","Id","UUID"}) do
        local v=rawget(actor,field)
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    for _,v in pairs(actor) do
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    return nil
end

local function AK_Fire(actor,uidHint,me)
    local net=AK_FindNet()
    if not net then setStatus("network object not found");return false end
    local remote=AK_GetRemote()
    if not remote then setStatus("remote not found");return false end
    local char=actor.Character
    if not char then return false end
    local part=char:FindFirstChild(AuraKill.TargetPart)
        or char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
    if not part then return false end
    local pos=part.Position
    local uid=uidHint or AK_GetUID(actor)
    if not uid then return false end

    local n=math.random(1,3)
    local targetName=char.Name or "?"
    setStatus(("firing at %s (%s)"):format(part.Name,targetName))
    A.targetName=targetName

    local encSlash=AK_Encrypt({net._code,"InventoryAction","Slash",n},net)
    if encSlash then pcall(function() remote:FireServer(encSlash) end) end
    A.swings=A.swings+1

    -- Report-position trick: set SimulatedPosition/ForceNextPosition to the
    -- target's spot right before Impact — NOT CFrame, so the visible model
    -- never moves. ReplicatorService.lua reads ForceNextPosition-or-
    -- SimulatedPosition for the ReplicateMovement packet; this makes that
    -- packet (and whatever distance check rides on it) say the actor is
    -- standing right next to the target at the moment Impact lands.
    local originalSimPos,originalForcePos
    if me then
        originalSimPos=rawget(me,"SimulatedPosition")
        originalForcePos=rawget(me,"ForceNextPosition")
        pcall(function() me.SimulatedPosition=pos end)
        pcall(function() me.ForceNextPosition=pos end)
    end

    local encImpact=AK_Encrypt({net._code,"InventoryAction","Impact",{pos.X,pos.Y,pos.Z},uid,part.Name},net)
    if encImpact then pcall(function() remote:FireServer(encImpact) end) end
    A.impacts=A.impacts+1
    if A.impacts%5==0 then logEvent(("%d impacts sent"):format(A.impacts)) end

    if me then
        pcall(function() me.SimulatedPosition=originalSimPos end)
        pcall(function() me.ForceNextPosition=originalForcePos end)
    end

    return true
end

-- ---------------------------------------------------------------------------
-- Actor registry access. Mirrors how ActorManager.Enemies is used in the
-- confirmed-working module, but discovers the registry via getloadedmodules()
-- (ClientService/Replicator) since this standalone script has no ActorManager
-- of its own to piggy-back on.
-- ---------------------------------------------------------------------------
local _service,_serviceNextScan=nil,0
local SERVICE_NAMES={ClientService=true,["Client"]=true,["ClientHandler"]=true}
local function findService()
    if _service and _service.Replicator then return _service end
    local now=os.clock()
    if now<_serviceNextScan then return nil end -- don't hammer getloadedmodules() every tick
    _serviceNextScan=now+2
    for _,m in ipairs(getloadedmodules()) do
        -- m.Parent==nil means the ModuleScript was destroyed — require() on it
        -- throws a loud engine warning even inside pcall, so skip it first.
        if m.Parent and SERVICE_NAMES[m.Name] then
            local ok,value=pcall(require,m)
            if ok and type(value)=="table" and type(value.Replicator)=="table" then
                _service=value;return _service
            end
        end
    end
    for _,m in ipairs(getloadedmodules()) do
        if m.Parent then
            local ok,value=pcall(require,m)
            if ok and type(value)=="table" and type(value.Replicator)=="table"
                and type(value.Replicator.Actors)=="table" then
                _service=value;return _service
            end
        end
    end
    return nil
end
local function actorKind(actor,replicator)
    if not actor then return nil end
    if actor.IsLocalPlayer or actor.Owner==LocalPlayer or (replicator and actor==replicator.LocalActor) then
        return nil
    end
    if actor.Zombie==true then return "Zombies" end
    if actor.Owner==nil then return "NPCs" end
    if typeof(actor.Owner)=="Instance" and actor.Owner:IsA("Player") then return "Players" end
end

-- ---------------------------------------------------------------------------
-- AK_Tick — ported from the confirmed-working module: scan the registry,
-- collect everything in range, sort nearest-first, fire up to BatchSize.
-- ---------------------------------------------------------------------------
local function AK_Tick()
    if not AuraKill.Enabled then return end
    local now=os.clock()
    if now-AuraKill._lastFire<AuraKill.Interval then return end
    local service=findService()
    local replicator=service and service.Replicator
    local me=replicator and replicator.LocalActor
    if not me then setStatus("waiting for local actor");return end
    local myPos=me.CFrame and me.CFrame.Position
    if not myPos then return end

    local candidates={}
    for uid,actor in pairs(replicator.Actors or {}) do
        if actor and actor.Alive~=false and actor.Character and actorKind(actor,replicator) then
            local aPos=actor.Character.PrimaryPart and actor.Character.PrimaryPart.Position
            if aPos then
                local d=(aPos-myPos).Magnitude
                if d<=AuraKill.Range then
                    candidates[#candidates+1]={Actor=actor,UID=uid,Distance=d}
                end
            end
        end
    end
    if #candidates==0 then setStatus("waiting for a target");return end

    table.sort(candidates,function(a,b) return a.Distance<b.Distance end)
    AuraKill._lastFire=now

    local count=math.min(AuraKill.BatchSize,#candidates)
    for i=1,count do
        local c=candidates[i]
        task.spawn(function()
            if not AK_Fire(c.Actor,c.UID,me) then AuraKill._net=nil end
        end)
    end
end

local function setAura(value)
    AuraKill.Enabled=value
    setStatus(AuraKill.Enabled and "enabled" or "disabled")
end

