-- MTC Long-Range Aura Melee v5
-- Source đọc: MeleeInventory.lua, ReplicatorService.lua, ActorClass.lua,
--             CharacterController.lua, MeleeInventoryReplicator.lua, Melee.lua
--
-- ┌─ Spoof chain (từ source) ──────────────────────────────────────────────┐
-- │  ReplicatorService.Update() (10Hz / 0.1s):                             │
-- │    v138 = actor.ForceNextPosition OR actor.SimulatedPosition            │
-- │    FireUnreliableServer("ReplicateMovement", uid, v138.X,Y,Z, ...)     │
-- │    actor.ForceNextPosition = nil  ← cleared SAU mỗi tick               │
-- │                                                                         │
-- │  ReplicateActor handler (server → client):                              │
-- │    if uid == localUID: chỉ update Health — KHÔNG update position       │
-- │    → server broadcast position KHÔNG gây teleport cho local actor      │
-- │                                                                         │
-- │  Teleport bug root cause v4.x:                                          │
-- │    Loop 6+ tick gửi spoofPos → server lưu spoofPos ~0.6s               │
-- │    → actor state machine phía server dispatch move event về client      │
-- │    → character bị kéo về spoofPos                                       │
-- └────────────────────────────────────────────────────────────────────────┘
--
-- ┌─ Fix v5: ONE-SHOT FNP ─────────────────────────────────────────────────┐
-- │                                                                         │
-- │  t=0.000  : Slash fired                                                 │
-- │  t=0.120  : ForceNextPosition = spoofPos  (ĐẶT 1 LẦN DUY NHẤT)        │
-- │  t≈0.12+  : RS tick đọc FNP → gửi spoofPos → tự clear FNP             │
-- │             Server.actor.ServerPosition ← spoofPos (1 tick only)       │
-- │  t=0.250  : Impact fired — server thấy ta "đứng cạnh" target → HIT     │
-- │  t≈0.250+ : RS tick tiếp gửi real pos → server correct về real pos     │
-- │                                                                         │
-- │  Kết quả: server chỉ lưu spoofPos ≤ 0.1s (1 tick) thay vì 0.6s       │
-- │  → KHÔNG đủ thời gian trigger server-side position correction           │
-- │  → Character ĐỨNG YÊN suốt quá trình                                   │
-- │                                                                         │
-- │  SimulatedPosition KHÔNG bị đụng (CharacterController.Update()         │
-- │    line 1549 set SimulatedPosition = real_physics_pos mỗi frame)       │
-- └────────────────────────────────────────────────────────────────────────┘
--
-- ┌─ Fix v5: Dead NPC check ───────────────────────────────────────────────┐
-- │  Layer 1: actor.Alive == false → skip                                  │
-- │  Layer 2: actor.Health != nil && <= 0 → skip                           │
-- │  Layer 3: Character không tồn tại hoặc bị destroy → skip              │
-- │  Layer 4: Humanoid.Health <= 0 → skip                                  │
-- └────────────────────────────────────────────────────────────────────────┘

