-- ============================================================
-- AK_FindPart
-- ============================================================
local function AK_FindPart(char, partName)
    return char:FindFirstChild(partName)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
        or char.PrimaryPart
end

-- ============================================================
-- DirectSpoof — gửi ReplicateMovement trực tiếp
-- Không đụng ForceNextPosition → không teleport
-- UDP → server nhận trong ~10-30ms
--
-- RS.Update() (line 292) gửi chính xác params này:
--   FireUnreliableServer("ReplicateMovement", uid, x, y, z,
--     Orientation, Sprinting, HeightState, CameraX, CameraY,
--     LeanGoal, Platform, TeleportRevision or 0)
-- ============================================================
local function DirectSpoof(uid, spoofPos, myActor, net)
    local fus = rawget(net, "FireUnreliableServer")
    if type(fus) ~= "function" then return false end
    pcall(function()
        fus(net,
            "ReplicateMovement", uid,
            spoofPos.X, spoofPos.Y, spoofPos.Z,
            rawget(myActor, "Orientation")       or 0,
            rawget(myActor, "Sprinting")         or false,
            rawget(myActor, "HeightState")       or 0,
            rawget(myActor, "CameraX")           or 0,
            rawget(myActor, "CameraY")           or 0,
            rawget(myActor, "LeanGoal")          or 0,
            rawget(myActor, "Platform")          or false,
            rawget(myActor, "TeleportRevision")  or 0
        )
    end)
    return true
end

-- ============================================================
-- FNP Spoof — fallback nếu FireUnreliableServer không có
-- Stagger PHẢI ≥ 0.10s (1 RS tick) để đảm bảo RS fire trước Impact
-- ONE-SHOT: set FNP 1 lần, chờ RS clear trong ≤ 0.1s
-- ============================================================
local function FNPSpoof(spoofPos, myActor)
    pcall(function() myActor.ForceNextPosition = spoofPos end)
    -- Force RS fire ngay frame tiếp (v6 trick)
    pcall(function() ReplicatorService._lastReplicate = 0 end)
    task.wait()
    task.wait()
end

-- ============================================================
-- FireKill — 1 kill packet set cho 1 target, 1 round
-- Slash → wait → Spoof → wait(SpoofGap) → Impact
-- ============================================================
local function FireKill(actor, net, remote, uid_self, myActor)
    if IsActorDead(actor) then return end
    local char = rawget(actor, "Character")
    if not char then return end
    local part = AK_FindPart(char, AK.TargetPart)
    if not part then return end
    local uid = GetUID(actor)
    if not uid then return end

    -- Slash
    local encSlash = Encrypt(
        {net._code, "InventoryAction", "Slash", math.random(1, 3)},
        net
    )
    if encSlash then
        pcall(function() remote:FireServer(encSlash) end)
    end

    -- Chờ đến điểm gửi spoof
    local waitBeforeSpoof = math.max(0.01, AK.MeleeDelay - AK.SpoofGap)
    task.wait(waitBeforeSpoof)
    if IsActorDead(actor) then return end

    -- Spoof position
    local hitPos = part.Position
    local spoof  = hitPos + Vector3.new(0, AK.SpoofOffset, 0)

    if AK._directMode then
        DirectSpoof(uid_self, spoof, myActor, net)
        task.wait(AK.SpoofGap)
    else
        -- FNP fallback: SpoofGap trong FNP mode phải = Stagger ≥ 0.10s
        FNPSpoof(spoof, myActor)
        -- FNPSpoof already waited 2 frames (~33ms)
        -- Thêm buffer để đảm bảo đủ 0.10s total
        local extraWait = math.max(0, 0.10 - 0.033 - (AK.MeleeDelay - AK.SpoofGap - waitBeforeSpoof))
        if extraWait > 0 then task.wait(extraWait) end
    end

    -- Impact
    if IsActorDead(actor) then return end
    local freshPos = part.Position
    local encImpact = Encrypt(
        {net._code, "InventoryAction", "Impact",
         {freshPos.X, freshPos.Y, freshPos.Z}, uid, part.Name},
        net
    )
    if encImpact then
        pcall(function() remote:FireServer(encImpact) end)
    end
end

-- ============================================================
-- AK_FireBatch
--
-- Per target: spawn FireKill coroutine(s)
--   - 1 coroutine nếu MultiHit=1
--   - 2 coroutines nếu MultiHit=2 (Round2 starts 20ms after Round1)
--
-- Stagger giữa targets: AK.Stagger (default 16ms)
--   DirectMode: 16ms (FNP không được set → không interference)
--   FNP fallback: auto-clamp ≥ 100ms (đảm bảo RS có 1 tick per target)
-- ============================================================
local function AK_FireBatch(candidates, count, net, remote, myActor, uid_self)
    -- Auto-clamp stagger in FNP mode
    local stagger = AK.Stagger
    if not AK._directMode then
        stagger = math.max(0.10, stagger)
    end

    for i = 1, count do
        local tOffset = (i - 1) * stagger

        -- Round 1
        task.delay(tOffset, function()
            FireKill(candidates[i].Actor, net, remote, uid_self, myActor)
        end)

        -- Round 2 (MultiHit=2): 20ms sau Round 1
        if AK.MultiHit >= 2 then
            task.delay(tOffset + 0.020, function()
                FireKill(candidates[i].Actor, net, remote, uid_self, myActor)
            end)
        end
    end

    -- Release lock
    local lockDelay = (count - 1) * stagger + AK.MeleeDelay
    if AK.MultiHit >= 2 then lockDelay = lockDelay + 0.020 end
    lockDelay = lockDelay + 0.10
    task.delay(lockDelay, function()
        AK._lock = false
    end)
end

-- ============================================================
-- AK_Tick — Heartbeat loop
-- ============================================================
local function AK_Tick()
    if not AK.Enabled then return end
    if AK._lock then return end
    local now = tick()
    if now - AK._lastFire < AK.Interval then return end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return end
    local uid_self = ReplicatorService._uid
    if not uid_self then return end

    local net = AK_FindNet()
    if not net then return end
    local remote = AK_GetRemote()
    if not remote then return end

    local myPos
    pcall(function() myPos = myActor.Position end)
    if not myPos then
        local cam = workspace.CurrentCamera
        myPos = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
    end

    local candidates = {}
    if rawget(ReplicatorService, "Actors") then
        for _, actor in pairs(ReplicatorService.Actors) do
            if type(actor) ~= "table" then continue end
            if actor == myActor then continue end
            if IsActorDead(actor) then continue end
            local aPos
            pcall(function() aPos = actor.Position end)
            if not aPos then pcall(function() aPos = actor.ServerPosition end) end
            if not aPos then
                local char = rawget(actor, "Character")
                if char and char.PrimaryPart then
                    pcall(function() aPos = char.PrimaryPart.Position end)
                end
            end
            if not aPos then continue end
            local d = (aPos - myPos).Magnitude
            if d <= AK.Range then
                candidates[#candidates + 1] = {Actor = actor, Dist = d}
            end
        end
    end

    if #candidates == 0 then return end
    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

    AK._lastFire = now
    AK._lock     = true

    local count = math.min(AK.BatchSize, #candidates)
    AK_FireBatch(candidates, count, net, remote, myActor, uid_self)
end

function AK.Start()
    if AK._running then return end
    local net = AK_FindNet()
    if net then
        local fus = rawget(net, "FireUnreliableServer")
        AK._directMode = type(fus) == "function"
    end
    AK._running = true
    AK._conn = Track(RunService.Heartbeat:Connect(AK_Tick))
    local stagger = AK._directMode and AK.Stagger or math.max(0.10, AK.Stagger)
    local totalMs = math.floor(((AK.BatchSize - 1) * stagger + AK.MeleeDelay) * 1000)
    local mode = AK._directMode and "DirectSpoof" or "FNP Fallback"
    print(string.format("[LRM8] Started | Mode: %s | Batch: %d targets in ~%dms | MultiHit: %dx",
        mode, AK.BatchSize, totalMs, AK.MultiHit))
end

function AK.Stop()
    AK._running = false
    AK._lock    = false
    if AK._conn then
        pcall(function() AK._conn:Disconnect() end)
        AK._conn = nil
    end
    if not AK._directMode then
        local myActor = ReplicatorService and ReplicatorService.LocalActor
        if myActor then pcall(function() myActor.ForceNextPosition = nil end) end
    end
    print("[LRM8] Stopped")
end

