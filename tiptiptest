local function selectNpc()
    local npc = hoveredNpc
    if not (npc and npc.Parent) then
        local _, inst = aimPoint(true)
        npc = npcFromInstance(inst)
    end
    if not npc then
        event("no NPC under the crosshair")
        return
    end
    if npc == selectedNpc then
        clearSelection()
        event("NPC deselected")
        return
    end
    if selectedHL then
        selectedHL:Destroy()
    end
    selectedNpc = npc
    selectedFeetDrop = npcFeetDrop(npc, npcRoot(npc))
    local _, uid = actorOfModel(npc)
    selectedUid = uid

    local hl = Instance.new("Highlight")
    hl.Adornee = npc
    hl.FillColor = following and CONFIG.FollowColor or CONFIG.SelectColor
    hl.FillTransparency = 0.5
    hl.OutlineColor = hl.FillColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = camera
    selectedHL = hl

    if following then
        event(("NPC re-targeted: %s (decoy follows it now)"):format(npc.Name))
    else
        event(("NPC selected: %s%s, press %s to follow it"):format(npc.Name, uid and (" (" .. uid .. ")") or " (not a networked actor)", CONFIG.FollowKey.Name))
        if CONFIG.SelectStartsFollow then
            toggleFollow()
        end
    end
end

toggleFollow = function()
    if following then
        following = false
        event("stopped following, decoy holds its last spot")
        return
    end
    local root = selectedNpc and selectedNpc.Parent and npcRoot(selectedNpc)
    if not root then
        event(("select an NPC first (aim and press %s)"):format(CONFIG.SelectKey.Name))
        return
    end
    if not (placed and not placed.returning) then
        placeDecoyAt(root.Position - Vector3.new(0, selectedFeetDrop, 0) + CONFIG.FollowOffset, false, true)
        if not placed then
            return
        end
    end
    following = true
    event("decoy following " .. selectedNpc.Name)
end

