local AK = {
    Enabled     = false,
    Range       = 1000,
    Interval    = 0.02,   -- 50Hz (tăng từ 20Hz)
    BatchSize   = 20,     -- tăng từ 15

    SpoofOffset  = 1.5,
    MeleeDelay   = 0.25,
    FNPLead      = 0.13,

    -- v6: số lần fire Impact mỗi hit
    ImpactRepeat = 3,
    ImpactSpacing = 0.015,  -- 15ms giữa mỗi Impact repeat

    TargetPart   = "Head",
    _lastFire    = 0,
    _conn        = nil,
    _running     = false,
    _lock        = false,

    -- Stats
    _hitCount    = 0,
    _missCount   = 0,
    _fireCount   = 0,
}

-- ============================================================
-- AK_FindPart
-- ============================================================
local function AK_FindPart(char, partName)
    return char:FindFirstChild(partName)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
        or char.PrimaryPart
end

-- ============================================================
-- AK_SpoofChain — v6 SimPos → FNP → FNP → ServerPos
--
-- Write order đảm bảo cả 2 path RS đọc đều = spoofPos:
--   Path A (primary): FNP [2][3] → RS đọc → gửi spoofPos → clear FNP
--   Path B (fallback): SimPos [1] → RS fallback nếu FNP đã clear
--   Path C (direct):   ServerPosition [4] → write trực tiếp nếu writable
--
-- Coverage: ~0.2s (2 RS ticks) thay vì ~0.1s (1 RS tick) của v5
-- ============================================================
local function AK_SpoofChain(myActor, spoofPos)
    -- [1] SimulatedPosition — ghi đè CharacterController.Update() line 1549
    --     CC set SimPos = real_pos mỗi frame, ta ghi đè ngay trước RS tick
    pcall(function() myActor.SimulatedPosition = spoofPos end)

    -- [2] ForceNextPosition — RS ưu tiên đọc FNP trước SimPos
    pcall(function() myActor.ForceNextPosition = spoofPos end)

    -- [3] ForceNextPosition second write — belt+suspenders
    --     Nếu RS tick xảy ra giữa [2] và [3], write [3] cover tick tiếp
    pcall(function() myActor.ForceNextPosition = spoofPos end)

    -- [4] ServerPosition direct write — nếu field này writable từ client
    --     (một số MTC builds expose nó), cover path RS không đọc FNP/SimPos
    pcall(function() myActor.ServerPosition = spoofPos end)
end

-- ============================================================
-- AK_Fire — SimPos chain + Impact repeat
-- ============================================================
local function AK_Fire(actor)
    local net = AK_FindNet()
    if not net then
        Log("Fire SKIP — no network")
        return false
    end
    local remote = AK_GetRemote()
    if not remote then
        Log("Fire SKIP — no remote")
        return false
    end
    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then
        Log("Fire SKIP — no LocalActor")
        return false
    end
    if IsActorDead(actor) then return false end

    local char = rawget(actor, "Character")
    if not char then return false end
    local part = AK_FindPart(char, AK.TargetPart)
    if not part then return false end
    local uid = GetUID(actor)
    if not uid then
        Log("Fire SKIP — no UID")
        return false
    end

    AK._fireCount = AK._fireCount + 1

    -- ── Slash at t=0 ─────────────────────────────────────────
    local n = math.random(1, 3)
    local encSlash = Encrypt({net._code, "InventoryAction", "Slash", n}, net)
    if encSlash then
        pcall(function() remote:FireServer(encSlash) end)
        Log("Slash → uid:" .. uid:sub(1,8) .. " n=" .. n)
    end

    -- ── Spoof chain at t = (MeleeDelay - FNPLead) ────────────
    -- v6: SimPos + FNP×2 + ServerPos chain
    local fnpDelay = math.max(0.01, AK.MeleeDelay - AK.FNPLead)
    task.delay(fnpDelay, function()
        if IsActorDead(actor) then return end
        local p2 = AK_FindPart(char, AK.TargetPart)
        if not p2 then return end
        local h2    = p2.Position
        local spoof = h2 + Vector3.new(0, AK.SpoofOffset, 0)
        AK_SpoofChain(myActor, spoof)
        Log("SpoofChain SET → " .. string.format("(%.1f,%.1f,%.1f)", spoof.X, spoof.Y, spoof.Z))
    end)

    -- ── Impact × ImpactRepeat at t = MeleeDelay ──────────────
    -- Fire Impact beberapa kali dengan spacing 15ms
    -- Server dedup pada tick yang sama, tapi pada server laggy
    -- salah satu packet masuk di timing yang tepat
    task.delay(AK.MeleeDelay, function()
        if IsActorDead(actor) then return end

        -- Clear SimPos sau khi Impact fired — trả CharacterController về normal
        task.delay(AK.ImpactRepeat * AK.ImpactSpacing + 0.05, function()
            pcall(function()
                myActor.SimulatedPosition = nil
            end)
        end)

        for repeat_i = 1, AK.ImpactRepeat do
            task.delay((repeat_i - 1) * AK.ImpactSpacing, function()
                if IsActorDead(actor) then return end
                local p3 = AK_FindPart(char, AK.TargetPart)
                if not p3 then return end
                local h3 = p3.Position

                local encImpact = Encrypt(
                    {net._code, "InventoryAction", "Impact",
                     {h3.X, h3.Y, h3.Z}, uid, p3.Name},
                    net
                )
                if encImpact then
                    local ok = pcall(function() remote:FireServer(encImpact) end)
                    if ok then
                        AK._hitCount = AK._hitCount + 1
                        if repeat_i == 1 then
                            Log("Impact[" .. repeat_i .. "] → uid:" .. uid:sub(1,8)
                                .. string.format(" pos=(%.1f,%.1f,%.1f)", h3.X, h3.Y, h3.Z))
                        end
                    else
                        AK._missCount = AK._missCount + 1
                        Log("Impact[" .. repeat_i .. "] FAIL")
                    end
                end
            end)
        end
    end)

    return true
end

-- ============================================================
-- AK_Tick
-- ============================================================
local function AK_Tick()
    if not AK.Enabled then return end
    if AK._lock then return end
    local now = tick()
    if now - AK._lastFire < AK.Interval then return end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return end

    local myPos
    pcall(function() myPos = myActor.Position end)
    if not myPos then
        local cam = workspace.CurrentCamera
        myPos = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
    end

    local candidates = {}
    if rawget(ReplicatorService, "Actors") then
        for _, actor in pairs(ReplicatorService.Actors) do
            if type(actor) ~= "table" then continue end
            if actor == myActor then continue end
            if IsActorDead(actor) then continue end

            local aPos
            pcall(function() aPos = actor.Position end)
            if not aPos then
                pcall(function() aPos = actor.ServerPosition end)
            end
            if not aPos then
                local char = rawget(actor, "Character")
                if char then
                    local pp = char.PrimaryPart
                    if pp then pcall(function() aPos = pp.Position end) end
                end
            end
            if not aPos then continue end

            local d = (aPos - myPos).Magnitude
            if d <= AK.Range then
                candidates[#candidates + 1] = {Actor = actor, Dist = d}
            end
        end
    end

    if #candidates == 0 then return end
    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

    AK._lastFire = now
    AK._lock     = true

    local count = math.min(AK.BatchSize, #candidates)
    task.spawn(function()
        for i = 1, count do
            if not AK.Enabled then break end
            AK_Fire(candidates[i].Actor)
            task.wait(0.10)
        end
        AK._lock = false
    end)
end

-- ============================================================
-- Start / Stop
-- ============================================================
function AK.Start()
    if AK._running then return end
    AK._running = true
    AK._hitCount = 0; AK._missCount = 0; AK._fireCount = 0
    AK._conn = Track(RunService.Heartbeat:Connect(AK_Tick))
    Log("AK Started — Delay:" .. AK.MeleeDelay
        .. " Lead:" .. AK.FNPLead
        .. " Range:" .. AK.Range
        .. " Repeat×" .. AK.ImpactRepeat)
end

function AK.Stop()
    AK._running = false
    AK._lock    = false
    if AK._conn then
        pcall(function() AK._conn:Disconnect() end)
        AK._conn = nil
    end
    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if myActor then
        pcall(function() myActor.ForceNextPosition = nil end)
        pcall(function() myActor.SimulatedPosition = nil end)
        pcall(function() myActor.ServerPosition = nil end)
    end
    Log("AK Stopped — fires:" .. AK._fireCount
        .. " hits:" .. AK._hitCount
        .. " miss:" .. AK._missCount)
end

