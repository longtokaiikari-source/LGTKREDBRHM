                             -- Nếu server reject: tăng lên (F2)
                             -- Nếu FNP fallback mode: tự động ≥ 0.10s

    SpoofGap      = 0.05,    -- DirectSpoof → Impact gap (50ms, UDP latency buffer)

    MultiHit      = 1,       -- 1 = 1 round, 2 = 2 rounds Slash+Impact per target
                             -- Toggle: F10

    -- ─ INTERNAL ───────────────────────────────────────────────
    TargetPart    = "Head",
