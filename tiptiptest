--[[
    MTC Long-Range Aura Melee — v11
    ──────────────────────────────────────────────────────────
    SOURCE INSIGHT (CharacterController + ReplicatorService):

    ReplicatorService.Update() → throttled: _lastReplicate = tick() + 0.1
    → Only 1 ReplicateMovement packet per 100ms via RS.
    → Calling v_u_1:FireUnreliableServer() DIRECTLY bypasses this throttle.
    → We spam N packets directly → server sees spoofed pos instantly.

    CharacterController.Teleport():
        actor.ForceNextPosition = pos   ← RS.Update reads this next tick
        actor.SimulatedPosition  = pos  ← visual position
        actor.Position           = pos  ← physical position

    MeleeInventory flow (per swing):
        Slash(random1-3) → delay(Delay) → Impact({x,y,z}, uid, part)

    STRATEGY v11 (zero wait, spam position, burst kill):
    ──────────────────────────────────────────────────────────
    Per cycle:
      1. Scan all NPCs in aura radius
      2. Calc centroid of all targets
      3. Spam SPAM_COUNT packets: FireUnreliableServer("ReplicateMovement", ...)
         → NO wait — server gets flooded with our spoofed pos immediately
      4. Fire Slash (animRandom)
      5. Spam SPAM_COUNT more during Delay window (halfway through)
      6. task.wait(Delay from Melee.lua config)
      7. Burst Impact all targets simultaneously
      8. Wait remaining timer - Delay before next cycle

    Result: ~0.25s cycle time regardless of NPC count. Fast.
--]]

-- ════════════════════════════════════════════════════════════
--  CONFIG
-- ════════════════════════════════════════════════════════════
local CFG = {
    AuraRadius   = 80,    -- studs
    SpamCount    = 8,     -- position packets per spam burst
    SpamCount2   = 5,     -- mid-delay spam burst count
    BodyPart     = "Head",
    PartOffset   = Vector3.new(0, 1.5, 0),
    Debug        = true,
    -- Overrides (nil = use Melee.lua values auto-detected)
    DelayOverride = nil,
    TimerOverride = nil,
}

-- Exact values from Melee.lua source
local MELEE_CFG = {
    Tomahawk={Delay=0.30,Time=1.00,Reach=7},M9_Bayonet={Delay=0.25,Time=0.50,Reach=5},
    KitchenCleaver={Delay=0.25,Time=0.50,Reach=5},KitchenKnife={Delay=0.25,Time=0.50,Reach=5},
    KitchenKnifeLong={Delay=0.25,Time=0.50,Reach=5},KitchenCleaverWood={Delay=0.25,Time=0.50,Reach=5},
    KitchenKnifeWood={Delay=0.25,Time=0.50,Reach=5},KitchenKnifeLongWood={Delay=0.25,Time=0.50,Reach=5},
    MI211={Delay=0.25,Time=0.50,Reach=5},SealPup={Delay=0.25,Time=0.50,Reach=5},
    Machete={Delay=0.35,Time=0.75,Reach=6},Taiga={Delay=0.35,Time=0.75,Reach=6},
    SOCP={Delay=0.25,Time=0.50,Reach=5},
    Hooligan={Delay=0.30,Time=1.00,Reach=7},Pipe={Delay=0.30,Time=1.00,Reach=6},
