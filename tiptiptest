-- Auto-scroll xuống khi có log mới
local function AutoScroll()
    task.wait()
    local canvas = scrollFrame.AbsoluteCanvasSize.Y
    local frame_h = scrollFrame.AbsoluteSize.Y
    if canvas > frame_h then
        scrollFrame.CanvasPosition = Vector2.new(0, canvas - frame_h)
    end
end

-- Patch Console label setter để auto-scroll
local _origLblSet = Console
local _realLog = Log
Log = function(msg)
    if not Console.Enabled then return end
    local ts   = string.format("[%05.1f] ", tick() % 1000)
    local line = ts .. tostring(msg)
    table.insert(Console.Lines, line)
    if #Console.Lines > Console.MaxLines then
        table.remove(Console.Lines, 1)
    end
    if Console.Label then
        local start   = math.max(1, #Console.Lines - 18)
        local visible = {}
        for i = start, #Console.Lines do
            visible[#visible + 1] = Console.Lines[i]
        end
        Console.Label.Text = table.concat(visible, "\n")
        task.spawn(AutoScroll)
    end
    print(line)
end

