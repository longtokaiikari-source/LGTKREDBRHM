local Console = {
    Lines    = {},
    MaxLines = 80,
    Label    = nil,   -- TextLabel ref, set by UI
    Enabled  = true,
}

local function Log(msg)
    if not Console.Enabled then return end
    local ts  = string.format("[%05.1f] ", tick() % 1000)
    local line = ts .. tostring(msg)
    table.insert(Console.Lines, line)
    if #Console.Lines > Console.MaxLines then
        table.remove(Console.Lines, 1)
    end
    if Console.Label then
        -- TextLabel multi-line: join last 10 lines
        local start = math.max(1, #Console.Lines - 9)
        local visible = {}
        for i = start, #Console.Lines do
            visible[#visible + 1] = Console.Lines[i]
        end
        Console.Label.Text = table.concat(visible, "\n")
    end
    print(line)
end

-- ============================================================
-- GC SCAN
-- ============================================================
local ReplicatorService = nil
local Network           = nil

local function DoScan()
    local ok, gc = pcall(filtergc, "table")
    if not ok then ok, gc = pcall(getgc, true) end
    if not ok or type(gc) ~= "table" then
        Log("GC scan: pcall failed")
        return
    end
    local i = 0
    for _, obj in pairs(gc) do
        i = i + 1
        if i % 8000 == 0 then task.wait() end
        if type(obj) ~= "table" then continue end
        if not ReplicatorService
            and rawget(obj, "Actors")
            and rawget(obj, "LocalActor")
        then
            ReplicatorService = obj
            Log("RS found at GC idx ~" .. i)
        end
        if not Network then
            local fs = rawget(obj, "FireServer")
            local ev = rawget(obj, "_events")
            local co = rawget(obj, "_code")
            local ky = rawget(obj, "_key")
            if fs and ev
                and type(co) == "string"
                and co:match("^%x+%-%x+%-%x+%-%x+%-%x+$")
                and type(ky) == "table" and #ky >= 5
            then
                local allNums = true
                for _, n in ipairs(ky) do
                    if type(n) ~= "number" then allNums = false; break end
                end
                if allNums then
                    Network = obj
                    Log("Net found — code: " .. co:sub(1,8) .. "... key[1]=" .. tostring(ky[1]))
                end
            end
        end
        if ReplicatorService and Network then break end
    end
end

-- ============================================================
-- AK_FindNet
-- ============================================================
local function AK_FindNet()
    if Network and rawget(Network, "_code") then return Network end
    if shared and type(shared.import) == "function" then
        local ok, net = pcall(function() return shared.import("network") end)
        if ok and net
            and rawget(net, "_key")
            and rawget(net, "_code")
        then
            Network = net
            Log("Net via shared.import OK")
            return net
        end
    end
    local ok, gc = pcall(filtergc, "table")
    if not ok then ok, gc = pcall(getgc, true) end
    if ok and gc then
        for _, v in pairs(gc) do
            if type(v) ~= "table" then continue end
            local k  = rawget(v, "_key")
            local co = rawget(v, "_code")
            local ev = rawget(v, "_events")
            if type(k) == "table" and #k >= 5
                and type(co) == "string"
                and co:match("^%x+%-%x+%-%x+%-%x+%-%x+$")
                and type(ev) == "table"
            then
                local allNums = true
                for _, n in ipairs(k) do
                    if type(n) ~= "number" then allNums = false; break end
                end
                if allNums then
                    Network = v
                    Log("Net via GC fallback — code: " .. co:sub(1,8))
                    return v
                end
            end
        end
    end
    Log("Net FAIL — rescan needed")
    return nil
end

-- ============================================================
-- AK_GetRemote
-- ============================================================
local _remote = nil
local function AK_GetRemote()
    if _remote and _remote.Parent then return _remote end
    local ev = ReplicatedStorage:FindFirstChild("Events")
    if ev then
        local re = ev:FindFirstChild("RemoteEvent")
        if re then
            _remote = re
            Log("Remote: Events.RemoteEvent OK")
            return re
        end
    end
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            _remote = v
            Log("Remote: " .. v:GetFullName())
            return v
        end
    end
    Log("Remote: FAIL")
    return nil
end

-- ============================================================
-- CIPHER
-- ============================================================
local function NetEncode(jsonStr, key)
    local result = {}
    for i = 1, #jsonStr do
        local ki   = i % 4
        local kval = key[ki + 1]
        local nb   = (string.byte(jsonStr, i) - 32 + kval) % 95 + 32
        result[i]  = string.char(nb)
    end
    local firstByte = string.byte(jsonStr, 1)
    local base = #jsonStr
    for v24 = 1, key[5] do
        result[base + v24] = string.char(firstByte - string.byte(tostring(v24), 1))
    end
    return table.concat(result)
end

local function Encrypt(data, net)
    local ok, raw = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or not raw then return nil end
    return NetEncode(raw, net._key)
end

-- ============================================================
-- UID CACHE
-- ============================================================
local _uidCache = setmetatable({}, {__mode = "k"})
local function GetUID(actor)
    if _uidCache[actor] then return _uidCache[actor] end
    for _, f in ipairs({"UID","_uid","UUID","_id","Id"}) do
        local v = rawget(actor, f)
        if type(v) == "string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
            _uidCache[actor] = v; return v
        end
    end
    for _, v in pairs(actor) do
        if type(v) == "string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
            _uidCache[actor] = v; return v
        end
    end
    local ok2, v2 = pcall(function() return actor.UID end)
    if ok2 and type(v2) == "string" and v2:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
        _uidCache[actor] = v2; return v2
    end
    return nil
end

-- ============================================================
-- IsActorDead — NPC dead check, 4 layers
-- ============================================================
local function IsActorDead(actor)
    if rawget(actor, "Alive") == false then return true end
    local health = rawget(actor, "Health")
    if health ~= nil and health <= 0 then return true end
    local char = rawget(actor, "Character")
    if not char then return true end
    local ok, parent = pcall(function() return char.Parent end)
    if not ok or not parent then return true end
    local ok2, hum = pcall(function()
        return char:FindFirstChildOfClass("Humanoid")
    end)
    if ok2 and hum then
        local ok3, hp = pcall(function() return hum.Health end)
        if ok3 and hp ~= nil and hp <= 0 then return true end
    end
    return false
end

