local AK = {
    Enabled     = false,
    Range       = 1000,  -- studs
    Interval    = 0.05,  -- giây giữa mỗi batch
    BatchSize   = 15,    -- targets mỗi batch

    SpoofOffset = 1.5,   -- studs
    MeleeDelay  = 0.25,  -- Slash → Impact (từ Melee.lua Delay field)

    -- v6: stagger giữa các target
    -- 0.032s = 2 frames @ 60fps
    -- Đủ để FNP + _lastReplicate=0 → RS fire → server nhận trước Impact
    Stagger     = 0.032,

    TargetPart  = "Head",
    _lastFire   = 0,
    _conn       = nil,
    _running    = false,
    _lock       = false,
}

-- ============================================================
-- AK_FindPart
-- ============================================================
local function AK_FindPart(char, partName)
    return char:FindFirstChild(partName)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
        or char.PrimaryPart
end

-- ============================================================
-- AK_Tick — PARALLEL coroutines, 32ms stagger
--
-- Với BatchSize=15, Stagger=0.032:
--   Target 1  fires at t=0.000s
--   Target 2  fires at t=0.032s
--   ...
--   Target 15 fires at t=0.448s
--   Last Impact lands at t=0.448+0.25 = 0.698s
--
-- Tổng: ~0.7s cho 15 targets (vs 1.75s ở v5.1)
--
-- Per-target coroutine timeline:
--   t=offset          : Slash fired
--   t=offset+0.218    : FNP set + ReplicatorService._lastReplicate = 0
--   t=offset+0.218+~16ms: RS Heartbeat fires, gửi spoofPos, clear FNP
--   t=offset+0.218+~32ms: 2nd frame safety pass
--   t=offset+0.250    : Impact fired (offset + MeleeDelay)
--
-- _lastReplicate = 0 trick:
--   RS.Update() checks: if _lastReplicate < tick() then
--   tick() luôn > 0 → check luôn pass → RS fire NGAY HEARTBEAT TIẾP THEO
--   Thay vì chờ natural cycle: _lastReplicate = now+0.1 → avg wait 50ms
-- ============================================================
local function AK_FireBatch(candidates, count, net, remote, myActor)
    -- Spawn parallel coroutine cho mỗi target
    for i = 1, count do
        local offset = (i - 1) * AK.Stagger
        task.delay(offset, function()
            if not AK.Enabled then return end

            local actor = candidates[i].Actor
            if IsActorDead(actor) then return end

            local char = rawget(actor, "Character")
            if not char then return end

            local part = AK_FindPart(char, AK.TargetPart)
            if not part then return end

            local uid = GetUID(actor)
            if not uid then return end

            -- Slash tại t = offset
            local encSlash = Encrypt(
                {net._code, "InventoryAction", "Slash", math.random(1, 3)},
                net
            )
            if encSlash then
                pcall(function() remote:FireServer(encSlash) end)
            end

            -- Chờ đến ngay trước Impact để set FNP
            -- MeleeDelay - Stagger = 0.25 - 0.032 = 0.218s
            -- Dùng Stagger thay vì hardcode để tự động scale
            task.wait(math.max(0.01, AK.MeleeDelay - AK.Stagger))

            -- Dead check trước FNP
            if IsActorDead(actor) then return end

            -- Set FNP + force RS fire ngay frame tiếp theo
            local hitPos = part.Position
            local spoof  = hitPos + Vector3.new(0, AK.SpoofOffset, 0)

            pcall(function()
                myActor.ForceNextPosition = spoof
            end)
            -- _lastReplicate = 0 → RS.Update() condition: 0 < tick() → TRUE
            -- → RS fire trên HEARTBEAT TIẾP THEO (~16ms) thay vì đợi cycle
            pcall(function()
                ReplicatorService._lastReplicate = 0
            end)

            -- 2 frames: đảm bảo RS đã gửi FNP trước khi Impact fire
            task.wait()  -- frame 1: RS picks up FNP, fires, clears FNP
            task.wait()  -- frame 2: safety margin

            -- Dead check cuối
            if IsActorDead(actor) then return end

            -- Impact — server đã thấy spoofPos → distance check pass
            local freshPos = part.Position
            local encImpact = Encrypt(
                {net._code, "InventoryAction", "Impact",
                 {freshPos.X, freshPos.Y, freshPos.Z}, uid, part.Name},
                net
            )
            if encImpact then
                pcall(function() remote:FireServer(encImpact) end)
            end
        end)
    end

    -- Giải phóng lock sau khi target cuối hoàn thành
    -- (count-1)*Stagger = thời gian đến coroutine cuối
    -- + MeleeDelay = thời gian Impact trong coroutine cuối
    -- + 0.1 = buffer
    task.delay((count - 1) * AK.Stagger + AK.MeleeDelay + 0.10, function()
        AK._lock = false
    end)
end

-- ============================================================
-- AK_Tick — main loop
-- ============================================================
local function AK_Tick()
    if not AK.Enabled then return end
    if AK._lock then return end
    local now = tick()
    if now - AK._lastFire < AK.Interval then return end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return end

    local net = AK_FindNet()
    if not net then return end
    local remote = AK_GetRemote()
    if not remote then return end

    -- Vị trí của mình
    local myPos
    pcall(function() myPos = myActor.Position end)
    if not myPos then
        local cam = workspace.CurrentCamera
        myPos = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
    end

    -- Scan enemies
    local candidates = {}
    if rawget(ReplicatorService, "Actors") then
        for _, actor in pairs(ReplicatorService.Actors) do
            if type(actor) ~= "table" then continue end
            if actor == myActor then continue end
            if IsActorDead(actor) then continue end

            local aPos
            pcall(function() aPos = actor.Position end)
            if not aPos then
                pcall(function() aPos = actor.ServerPosition end)
            end
            if not aPos then
                local char = rawget(actor, "Character")
                if char then
                    local pp = char.PrimaryPart
                    if pp then pcall(function() aPos = pp.Position end) end
                end
            end
            if not aPos then continue end

            local d = (aPos - myPos).Magnitude
            if d <= AK.Range then
                candidates[#candidates + 1] = {Actor = actor, Dist = d}
            end
        end
    end

    if #candidates == 0 then return end

    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

    AK._lastFire = now
    AK._lock     = true

    local count = math.min(AK.BatchSize, #candidates)
    AK_FireBatch(candidates, count, net, remote, myActor)
end

function AK.Start()
    if AK._running then return end
    AK._running = true
    AK._conn = Track(RunService.Heartbeat:Connect(AK_Tick))
    print("[LRM6] Started — Stagger:", AK.Stagger, "Delay:", AK.MeleeDelay, "Range:", AK.Range)
    print(string.format("[LRM6] Batch %d targets in %.3fs (vs %.3fs in v5)",
        AK.BatchSize,
        (AK.BatchSize - 1) * AK.Stagger + AK.MeleeDelay,
        (AK.BatchSize - 1) * 0.10       + AK.MeleeDelay
    ))
end

function AK.Stop()
    AK._running = false
    AK._lock    = false
    if AK._conn then
        pcall(function() AK._conn:Disconnect() end)
        AK._conn = nil
    end
    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if myActor then
        pcall(function() myActor.ForceNextPosition = nil end)
    end
    print("[LRM6] Stopped")
end

