        auraKeyBtn.Text = rebinding == "AuraKey" and "press a key..." or ("aura: " .. CONFIG.AuraKey.Name)

        local first = math.max(1, #menuLines - 11)
        local shown = {}
        for i = first, #menuLines do
            table.insert(shown, menuLines[i])
        end
        logLabel.Text = table.concat(shown, "\n")
    end

    return gui, update
end

