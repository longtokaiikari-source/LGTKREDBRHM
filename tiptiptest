-- MTC Long-Range Aura Melee v4.1
-- Source đọc: MeleeInventory.lua, ReplicatorService.lua, ActorClass.lua,
--             CharacterController.lua, MeleeInventoryReplicator.lua, Melee.lua
--
-- ┌─ Spoof chain (từ source) ──────────────────────────────────────────────┐
-- │  ReplicatorService.Update() (10Hz / 0.1s):                             │
-- │    v138 = actor.ForceNextPosition OR actor.SimulatedPosition            │
-- │    FireUnreliableServer("ReplicateMovement", uid, v138.X,Y,Z, ...)     │
-- │    actor.ForceNextPosition = nil  ← cleared sau mỗi tick               │
-- │                                                                         │
-- │  Server nhận ReplicateMovement → actor.ServerPosition = v138           │
-- │  Melee Impact check: (actor.ServerPosition - hitPos).Magnitude ≤ Reach │
-- │                                                                         │
-- │  FIX v4.1: CHỈ set ForceNextPosition, KHÔNG set SimulatedPosition      │
-- │  SimulatedPosition = CharacterController render pos → đụng vào = tele  │
-- │  ForceNextPosition = PRIORITY trong RS, chỉ gửi lên server, ko render  │
-- │  → Character đứng yên, server nghĩ ta đứng cạnh target → HIT           │
-- └────────────────────────────────────────────────────────────────────────┘
--
-- ┌─ MeleeInventory._use() timing (từ source) ─────────────────────────────┐
-- │  t=0.000 → FireServer("InventoryAction", "Slash", n)                   │
-- │  t=Delay  → actor:Action("Impact", dir)  → raycast → hitPos           │
-- │             FireServer("InventoryAction", "Impact", {x,y,z}, uid, bp)  │
-- │  Delay = 0.25s, Reach = 5–7st (Melee.lua)                             │
-- └────────────────────────────────────────────────────────────────────────┘
--
-- Strategy v4:
--   1. Start spoof: ForceNextPosition=spoofPos + SimulatedPosition=spoofPos @ 0.05s
--   2. Slash ngay lập tức (server ghi nhận swing bắt đầu)
--   3. Chờ MeleeDelay=0.25s  → trong thời gian này server nhận ReplicateMovement
--      với spoofPos (10Hz × 0.25s = ~2 ticks)
--   4. Impact với hitPos mới nhất. Server check: (spoofPos–hitPos).Magnitude=1.5 < 5 → PASS

