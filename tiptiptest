-- Hotkeys
-- ============================================================
Track(UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    local kc = inp.KeyCode
    if kc == Enum.KeyCode.F3 then
        AK.Enabled = not AK.Enabled
        if AK.Enabled then
            AK.Start()
            toggleBtn.Text       = "[ ON ]  Toggle Aura Kill"
            toggleBtn.TextColor3 = Color3.fromRGB(65, 210, 100)
            lblStatus.Text       = "Status  : ON"
            lblStatus.TextColor3 = Color3.fromRGB(65, 210, 100)
        else
            AK.Stop()
            toggleBtn.Text       = "[ OFF ]  Toggle Aura Kill"
            toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
            lblStatus.Text       = "Status  : OFF"
            lblStatus.TextColor3 = Color3.fromRGB(210, 65, 65)
        end
    elseif kc == Enum.KeyCode.F1 then
        AK.MeleeDelay = math.max(0.10, AK.MeleeDelay - 0.05)
        lblDelay.Text = string.format("Delay : %.3fs  Lead: %.2fs  Offset: %.1fst",
            AK.MeleeDelay, AK.FNPLead, AK.SpoofOffset)
        Log("Delay → " .. AK.MeleeDelay)
    elseif kc == Enum.KeyCode.F2 then
        AK.MeleeDelay = math.min(1.0, AK.MeleeDelay + 0.05)
        lblDelay.Text = string.format("Delay : %.3fs  Lead: %.2fs  Offset: %.1fst",
            AK.MeleeDelay, AK.FNPLead, AK.SpoofOffset)
        Log("Delay → " .. AK.MeleeDelay)
    elseif kc == Enum.KeyCode.F4 then
        AK.Range = math.max(5, AK.Range - 50)
        lblRange.Text = string.format("Range : %.0fst  Batch: %d  Interval: %.2fs",
            AK.Range, AK.BatchSize, AK.Interval)
        Log("Range → " .. AK.Range)
    elseif kc == Enum.KeyCode.F5 then
        AK.Range = math.min(9999, AK.Range + 50)
        lblRange.Text = string.format("Range : %.0fst  Batch: %d  Interval: %.2fs",
            AK.Range, AK.BatchSize, AK.Interval)
        Log("Range → " .. AK.Range)
    elseif kc == Enum.KeyCode.F6 then
        AK.FNPLead = math.min(AK.MeleeDelay - 0.02, AK.FNPLead + 0.02)
        lblDelay.Text = string.format("Delay : %.3fs  Lead: %.2fs  Offset: %.1fst",
            AK.MeleeDelay, AK.FNPLead, AK.SpoofOffset)
        Log("FNPLead → " .. AK.FNPLead)
    elseif kc == Enum.KeyCode.F7 then
        AK.FNPLead = math.max(0.02, AK.FNPLead - 0.02)
        lblDelay.Text = string.format("Delay : %.3fs  Lead: %.2fs  Offset: %.1fst",
            AK.MeleeDelay, AK.FNPLead, AK.SpoofOffset)
        Log("FNPLead → " .. AK.FNPLead)
    elseif kc == Enum.KeyCode.F8 then
        -- F8: tăng ImpactRepeat
        AK.ImpactRepeat = math.min(6, AK.ImpactRepeat + 1)
        lblRepeat.Text = string.format("Impact×%d  Spacing: %.0fms  50Hz tick",
            AK.ImpactRepeat, AK.ImpactSpacing * 1000)
        Log("ImpactRepeat → " .. AK.ImpactRepeat)
    elseif kc == Enum.KeyCode.F9 then
        -- F9: giảm ImpactRepeat
        AK.ImpactRepeat = math.max(1, AK.ImpactRepeat - 1)
        lblRepeat.Text = string.format("Impact×%d  Spacing: %.0fms  50Hz tick",
            AK.ImpactRepeat, AK.ImpactSpacing * 1000)
        Log("ImpactRepeat → " .. AK.ImpactRepeat)
    elseif kc == Enum.KeyCode.F10 then
        -- F10: toggle console visible
        consoleFrame.Visible = not consoleFrame.Visible
        Console.Enabled = consoleFrame.Visible
    end
end))

-- Stats + UI refresh ticker
local _lastTick2 = 0
Track(RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - _lastTick2 < 1 then return end
    _lastTick2 = now

    local net = Network
    lblNet.Text = net
        and ("Network : OK  key[1]=" .. tostring(net._key[1]))
        or   "Network : --"

    local n = 0
    if ReplicatorService and rawget(ReplicatorService, "Actors") then
        for _ in pairs(ReplicatorService.Actors) do n = n + 1 end
    end
    lblActors.Text = "Actors  : " .. n

    lblStats.Text = string.format("Fires: %d  Hits: %d  Miss: %d",
        AK._fireCount, AK._hitCount, AK._missCount)
end))

