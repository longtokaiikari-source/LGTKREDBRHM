local function actorOfModel(model)
    if not replicator then
        return nil
    end
    for uid, a in replicator.Actors do
        if type(a) == "table" and a.Character == model then
            return a, uid
        end
    end
    return nil
end

local function isNpc(model)
    if not model:IsA("Model") or model.Name == "AutoPickupDecoy" then
        return false
    end
    local me = replicator and replicator.LocalActor
    if model == localPlayer.Character or (me and model == me.Character) then
        return false
    end

    if actorOfModel(model) then
        return npcRoot(model) ~= nil
    end

    if next(CONFIG.NpcNames) ~= nil and not CONFIG.NpcNames[model.Name] then
        return false
    end
    if CONFIG.NpcNeedsHumanoid and not model:FindFirstChildOfClass("Humanoid") then
        return false
    end
    return npcRoot(model) ~= nil
end

local function npcFromInstance(inst)
    local m = inst and inst:FindFirstAncestorOfClass("Model")
    while m do
        if isNpc(m) then
            return m
        end
        m = m:FindFirstAncestorOfClass("Model")
    end
    return nil
end

local function clearSelection()
    if selectedHL then
        selectedHL:Destroy()
        selectedHL = nil
    end
    selectedNpc = nil
    selectedUid = nil
    following = false
