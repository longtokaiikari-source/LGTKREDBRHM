local function appendFile(line)
    if not CONFIG.LogToFile or not writefile then
        return
    end
    pcall(function()
        local exists = isfile and isfile(CONFIG.LogFile)
        if exists and appendfile then
            appendfile(CONFIG.LogFile, line .. "\n")
        elseif exists and readfile then
            writefile(CONFIG.LogFile, readfile(CONFIG.LogFile) .. line .. "\n")
        else
            writefile(CONFIG.LogFile, line .. "\n")
        end
    end)
end

local function event(text)
    local line = ("[%s] %s"):format(os.date("%H:%M:%S"), text)
    print("[autopickup] " .. line)
    appendFile(line)
    table.insert(menuLines, line)
    if #menuLines > 40 then
        table.remove(menuLines, 1)
    end
end

local function record(kind, name, uid, distance, tries)
    table.insert(logEntries, {
        time = os.time(),
        kind = kind,
        name = name,
        uid = uid,
        distance = distance,
        tries = tries,
    })
    event(("%s %s (%s) dist=%.1f tries=%d"):format(kind, name, uid, distance, tries))
end

local function debugLog(...)
    if CONFIG.Debug then
        print("[autopickup]", ...)
    end
end

local function printSummary()
    print(("[autopickup] summary: %d picked (%d via decoy), %d blocked, farthest pickup %.1f studs, %d hop sessions, %d decoys dropped"):format(
        stats.picked, stats.decoyPicked, stats.rejected, stats.maxDistance, stats.decoySessions, stats.placedDrops))
    local names = {}
    for name in totals do
        table.insert(names, name)
    end
    table.sort(names)
    for _, name in names do
        print(("[autopickup]   %dx %s"):format(totals[name], name))
    end
end

