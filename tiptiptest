-- MTC Long-Range Aura Melee v6
-- Method: SimulatedPosition → FNP → FNP → ServerPosition chain
-- Source: CharacterController.lua line 1549 (SimPos), ReplicatorService.Update() (FNP)
--
-- ┌─ v6 Spoof Chain (SimPos → FNP → FNP → ServerPos) ────────────────────┐
-- │                                                                        │
-- │  CharacterController.Update() line 1549:                              │
-- │    SimulatedPosition = real_physics_pos   ← set mỗi frame             │
-- │                                                                        │
-- │  ReplicatorService.Update() 10Hz:                                      │
-- │    v138 = ForceNextPosition OR SimulatedPosition                       │
-- │    → ưu tiên FNP, fallback SimPos                                      │
-- │    → FireUnreliableServer("ReplicateMovement", uid, v138.X,Y,Z ...)    │
-- │    → ForceNextPosition = nil (clear sau tick)                          │
-- │                                                                        │
-- │  v6 write order (tại FNPLead window):                                  │
-- │    [1] SimulatedPosition  = spoofPos  ← ghi đè CC.Update()            │
-- │    [2] ForceNextPosition  = spoofPos  ← RS ưu tiên đọc cái này        │
-- │    [3] ForceNextPosition  = spoofPos  ← ghi lần 2 (belt+suspenders)   │
-- │    [4] ServerPosition     = spoofPos  ← direct write nếu accessible   │
-- │                                                                        │
-- │  RS tick đọc FNP (field [2]/[3]) → gửi spoofPos → clear FNP          │
-- │  SimPos fallback vẫn = spoofPos cho đến khi CC.Update() override lại  │
-- │  → server nhận spoofPos confirmed từ 2 path (FNP + SimPos)            │
-- │  → hit window rộng hơn v5 (2 RS tick coverage thay vì 1)              │
-- └────────────────────────────────────────────────────────────────────────┘
--
-- ┌─ v6 Packet Boost ──────────────────────────────────────────────────────┐
-- │  Slash  → fire 1x                                                      │
-- │  Impact → fire 3x với 15ms spacing (server dedup nếu có,              │
-- │           nhưng window hit cao hơn nếu server laggy)                   │
-- │  Interval: 0.02s (50Hz tick thay vì 20Hz)                              │
-- │  BatchSize: 20 (tăng từ 15)                                            │
-- └────────────────────────────────────────────────────────────────────────┘

