local AK = {
    Enabled     = false,
    Range       = 1000,    -- studs
    Interval    = 0.05,    -- giây giữa mỗi batch tick
    BatchSize   = 15,      -- targets mỗi batch

    -- Spoof config — từ source analysis
    -- Reach min=5st (Melee.lua), offset=1.5st → luôn < Reach → PASS
    SpoofOffset  = 1.5,   -- khoảng cách spoofPos–hitPos (studs)

    -- MeleeDelay: từ Melee.lua Delay field = 0.25s
    -- Slash → task.delay(Delay, Impact) — phải match legit timing
    MeleeDelay   = 0.25,

    -- FNP lead time: đặt FNP trước Impact bao lâu để RS kịp tick
    -- RS 10Hz = 0.1s/tick. Lead = 0.13s → ít nhất 1 tick trong window
    FNPLead      = 0.13,

    TargetPart   = "Head",
    _lastFire    = 0,
    _conn        = nil,
    _running     = false,
    _lock        = false,
}

-- ============================================================
-- AK_FindPart — helper tìm body part của actor
-- ============================================================
local function AK_FindPart(char, partName)
    return char:FindFirstChild(partName)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("HumanoidRootPart")
        or char.PrimaryPart
end

-- ============================================================
-- AK_Fire — ONE-SHOT spoof + Slash → Impact
--
-- Timeline (MeleeDelay=0.25, FNPLead=0.13):
--   t=0.000  : Slash fired
--   t=0.120  : Set ForceNextPosition = spoofPos (ĐÚ́NG 1 LẦN)
--   t≈0.12+  : RS tick đọc FNP → gửi spoofPos lên server → clear FNP
--              → server.actor.ServerPosition ← spoofPos
--              → SimulatedPosition = KHÔNG bị đụng → character ĐỨNG YÊN
--   t=0.250  : Impact fired (fresh hitPos)
--              → server check: (spoofPos–hitPos).Magnitude = ~1.5st ≤ 5st → PASS
--   t≈0.250+ : RS tick tiếp gửi real pos → server correct lại
--              → character KHÔNG bị kéo đi đâu cả
-- ============================================================
local function AK_Fire(actor)
    local net = AK_FindNet()
    if not net then return false end
    local remote = AK_GetRemote()
    if not remote then return false end
    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return false end

    -- Dead check trước khi fire (fail-fast)
    if IsActorDead(actor) then return false end

    -- Target validation
    local char = rawget(actor, "Character")
    if not char then return false end
    local part = AK_FindPart(char, AK.TargetPart)
    if not part then return false end
    local uid = GetUID(actor)
    if not uid then return false end

    -- Slash tại t=0
    local n = math.random(1, 3)
    local encSlash = Encrypt({net._code, "InventoryAction", "Slash", n}, net)
    if encSlash then
        pcall(function() remote:FireServer(encSlash) end)
    end

    -- ── ONE-SHOT FNP tại t = (MeleeDelay - FNPLead) ─────────
    -- Đặt ForceNextPosition = spoofPos DUY NHẤT 1 LẦN
    -- RS sẽ đọc nó trong khoảng 0.13s tới và tự clear
    -- Server chỉ thấy spoofPos ≤ 1 RS tick (~0.1s) → KHÔNG đủ để trigger correction
    local fnpDelay = math.max(0.01, AK.MeleeDelay - AK.FNPLead)
    task.delay(fnpDelay, function()
        -- Check lại alive ngay trước khi spoof
        if IsActorDead(actor) then return end

        -- Re-read fresh part pos tại thời điểm set FNP
        local p2 = AK_FindPart(char, AK.TargetPart)
        if not p2 then return end
        local h2    = p2.Position
        local spoof = h2 + Vector3.new(0, AK.SpoofOffset, 0)

        -- Set FNP — RS sẽ đọc + clear trong tick tiếp theo
        pcall(function()
            myActor.ForceNextPosition = spoof
        end)
    end)

    -- ── Impact tại t = MeleeDelay ─────────────────────────────
    -- FNP đã được RS clear, server đã lưu spoofPos
    -- Fire Impact với fresh hitPos
    task.delay(AK.MeleeDelay, function()
        -- Dead check lần cuối
        if IsActorDead(actor) then return end

        -- Fresh hit pos tại thời điểm Impact
        local p3 = AK_FindPart(char, AK.TargetPart)
        if not p3 then return end
        local h3 = p3.Position

        local encImpact = Encrypt(
            {net._code, "InventoryAction", "Impact",
             {h3.X, h3.Y, h3.Z}, uid, p3.Name},
            net
        )
        if encImpact then
            pcall(function() remote:FireServer(encImpact) end)
        end
    end)

    return true
end

-- ============================================================
-- AK_Tick — sequential lock để tránh FNP race
-- ============================================================
local function AK_Tick()
    if not AK.Enabled then return end
    if AK._lock then return end
    local now = tick()
    if now - AK._lastFire < AK.Interval then return end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return end

    -- Vị trí của mình
    local myPos
    pcall(function() myPos = myActor.Position end)
    if not myPos then
        local cam = workspace.CurrentCamera
        myPos = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
    end

    -- Scan enemies từ ReplicatorService.Actors
    local candidates = {}
    if rawget(ReplicatorService, "Actors") then
        for _, actor in pairs(ReplicatorService.Actors) do
            if type(actor) ~= "table" then continue end
            if actor == myActor then continue end

            -- ── Multi-layer dead check ──────────────────────
            if IsActorDead(actor) then continue end

            -- Lấy vị trí target
            local aPos
            pcall(function() aPos = actor.Position end)
            if not aPos then
                pcall(function() aPos = actor.ServerPosition end)
            end
            if not aPos then
                local char = rawget(actor, "Character")
                if char then
                    local pp = char.PrimaryPart
                    if pp then pcall(function() aPos = pp.Position end) end
                end
            end
            if not aPos then continue end

            local d = (aPos - myPos).Magnitude
            if d <= AK.Range then
                candidates[#candidates + 1] = {Actor = actor, Dist = d}
            end
        end
    end

    if #candidates == 0 then return end

    -- Sort gần nhất trước
    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

    AK._lastFire = now
    AK._lock     = true

    local count = math.min(AK.BatchSize, #candidates)
    task.spawn(function()
        for i = 1, count do
            if not AK.Enabled then break end
            AK_Fire(candidates[i].Actor)
            task.wait(0.10)  -- 1 RS tick/target — đảm bảo mỗi FNP vào đúng tick riêng
        end
        AK._lock = false
    end)
end

function AK.Start()
    if AK._running then return end
    AK._running = true
    AK._conn = Track(RunService.Heartbeat:Connect(AK_Tick))
    print("[LRM5] Started — Delay:", AK.MeleeDelay, "FNPLead:", AK.FNPLead, "Range:", AK.Range)
end

function AK.Stop()
    AK._running = false
    AK._lock    = false
    if AK._conn then
        pcall(function() AK._conn:Disconnect() end)
        AK._conn = nil
    end
    -- Clear FNP khi stop (safety)
    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if myActor then
        pcall(function() myActor.ForceNextPosition = nil end)
    end
    print("[LRM5] Stopped")
end

