-- Drag
do
    local dragging,start,startPos=false
    panel.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true; start=inp.Position; startPos=panel.Position
            local conn; conn=game:GetService("UserInputService").InputChanged:Connect(function(i)
                if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                    local d=i.Position-start
                    panel.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
                end
            end)
            inp.Changed:Connect(function()
                if inp.UserInputState==Enum.UserInputState.End then dragging=false; conn:Disconnect() end
            end)
        end
    end)
end

-- Helpers
local function mkLabel(p)
    local l=Instance.new("TextLabel",panel); l.BackgroundTransparency=1; l.ZIndex=3; l.TextWrapped=true
    for k,v in p do pcall(function() l[k]=v end) end; return l
end
local function mkDivider(y)
    local d=Instance.new("Frame",panel); d.Size=UDim2.new(1,-40,0,1); d.Position=UDim2.new(0,20,0,y)
    d.BackgroundColor3=C.divider; d.BackgroundTransparency=0.5; d.BorderSizePixel=0; d.ZIndex=3
    local g=Instance.new("UIGradient",d)
    g.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,255,255)),ColorSequenceKeypoint.new(0.2,C.divider),ColorSequenceKeypoint.new(0.8,C.divider),ColorSequenceKeypoint.new(1,Color3.fromRGB(255,255,255))})
    g.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.15,0.5),NumberSequenceKeypoint.new(0.85,0.5),NumberSequenceKeypoint.new(1,1)})
    return d
end
local function mkBtn(text,color,size,pos)
    local b=Instance.new("TextButton",panel); b.Size=size; b.Position=pos; b.Text=text
    b.Font=Enum.Font.GothamBold; b.TextSize=14; b.TextColor3=Color3.fromRGB(255,255,255)
    b.BackgroundColor3=color; b.BackgroundTransparency=0.15; b.BorderSizePixel=0; b.ZIndex=3
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,9)
    local s=Instance.new("UIStroke",b); s.Color=Color3.fromRGB(255,255,255); s.Transparency=0.6; s.Thickness=1.2
    b.MouseEnter:Connect(function() tw(b,0.12,{BackgroundTransparency=0,BackgroundColor3=Color3.fromRGB(math.min(color.R*255+30,255),math.min(color.G*255+10,255),math.min(color.B*255+20,255))}) end)
    b.MouseLeave:Connect(function() tw(b,0.12,{BackgroundTransparency=0.15,BackgroundColor3=color}) end)
    b.MouseButton1Down:Connect(function() tw(b,0.06,{Size=UDim2.new(size.X.Scale,size.X.Offset-4,size.Y.Scale,size.Y.Offset-3)}) end)
    b.MouseButton1Up:Connect(function() tw(b,0.08,{Size=size}) end)
    return b
end

