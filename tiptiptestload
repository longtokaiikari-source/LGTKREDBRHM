-- Buttons (hidden until UNC done)
local pcBtn=mkBtn("💻  PC",C.btnPC,UDim2.new(0.5,-28,0,44),UDim2.new(0,20,0,196))
local mobileBtn=mkBtn("📱  Mobile",C.btnMobile,UDim2.new(0.5,-28,0,44),UDim2.new(0.5,8,0,196))
local loadLbl=mkLabel({Size=UDim2.new(1,-40,0,24),Position=UDim2.new(0,20,0,250),Text="",TextColor3=C.textDim,Font=Enum.Font.Gotham,TextSize=12,TextXAlignment=Enum.TextXAlignment.Center})
local discBtn

pcBtn.Visible=false; mobileBtn.Visible=false; pcBtn.Active=false; mobileBtn.Active=false

-- ─── Pop-in animation ─────────────────────────────────────────────────
tween(overlay,0.3,{BackgroundTransparency=0.55})
tween(panel,0.5,{Size=UDim2.fromOffset(W,H),BackgroundTransparency=0.08})
tween(panelStroke,0.5,{Transparency=0.2})

-- ─── Run UNC ──────────────────────────────────────────────────────────
local isBlocked=false
for name in pairs(blockedExecutors) do if currentExecutor:lower():find(name:lower()) then isBlocked=true; break end end

runUNC(function(rate, passes, fails)
    task.cancel(pulseThread)

    local uncColor = rate>=90 and C.pass or rate>=70 and C.warn or C.fail
    local petalStr = rate>=90 and "✿✿✿" or rate>=70 and "✿✿" or "✿"
    uncValueLbl.Text = string.format("%d%% %s (%d/%d)", rate, petalStr, passes, passes+fails)
    uncValueLbl.TextColor3 = uncColor
    barGrad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,C.accent),ColorSequenceKeypoint.new(1,uncColor)})
    tween(barFill,1.2,{Size=UDim2.new(rate/100,0,1,0)})

    if isBlocked or rate < 70 then
        panelStroke.Color=C.fail
        statusLbl.Text = isBlocked and "✗  Executor bị chặn — không hỗ trợ" or string.format("✗  UNC quá thấp (%d%% < 70%%)", rate)
        statusLbl.TextColor3=C.fail
        discBtn=mkBtn("💬  Discord Support (Copy Link)",C.btnBlock,UDim2.new(1,-40,0,44),UDim2.new(0,20,0,196))
        discBtn.MouseButton1Click:Connect(function()
            if setclipboard then setclipboard("https://discord.gg/deVVQEVybd"); discBtn.Text="✓  Copied!"; task.wait(2); discBtn.Text="💬  Discord Support (Copy Link)"
            else discBtn.Text="setclipboard không hỗ trợ" end
        end)
    else
        statusLbl.Text="✿  Chọn phiên bản của bạn"
        statusLbl.TextColor3=C.title
        pcBtn.Visible=true; mobileBtn.Visible=true
        pcBtn.Active=true; mobileBtn.Active=true
        tween(pcBtn,0.3,{BackgroundTransparency=0})
        tween(mobileBtn,0.3,{BackgroundTransparency=0})

        local loadingAnim
        local function loadScript(url,platform)
            pcBtn.Active=false; mobileBtn.Active=false
            tween(pcBtn,0.2,{BackgroundTransparency=0.5}); tween(mobileBtn,0.2,{BackgroundTransparency=0.5})
            local dots=""
            loadingAnim=task.spawn(function()
                while true do dots=dots=="..." and "" or dots.."."
                    loadLbl.Text="Đang tải "..platform..dots; task.wait(0.4)
                end
            end)
            task.wait(0.7)
            task.cancel(loadingAnim); loadLbl.Text="✿  Đang khởi động..."
            tween(overlay,0.4,{BackgroundTransparency=1}); tween(panel,0.4,{Size=UDim2.fromOffset(W*0.8,H*0.8),BackgroundTransparency=1}); tween(panelStroke,0.4,{Transparency=1})
            task.wait(0.5); sg:Destroy()
            local ok,err=pcall(function() loadstring(game:HttpGet(url))() end)
            if not ok then warn("[TokaiHub Loader] "..tostring(err)) end
        end

        pcBtn.MouseButton1Click:Connect(function() loadScript(URL_PC,"PC") end)
        mobileBtn.MouseButton1Click:Connect(function() loadScript(URL_MOBILE,"Mobile") end)
    end
end)
