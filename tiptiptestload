-- ─── Run fast UNC (instant, same frame basically) ─────────────────────
local isBlocked=false
for name in pairs(blockedExecutors) do
    if currentExecutor:lower():find(name:lower()) then isBlocked=true; break end
end

task.spawn(function()
    task.wait(0.5) -- wait for pop-in to feel natural
    local rate, passes, fails = fastUNC()

    local uncColor = rate>=90 and C.pass or rate>=70 and C.warn or C.fail
    local stars = rate>=90 and "✿✿✿" or rate>=70 and "✿✿" or "✿"
    uncLbl.Text=string.format("%d%% %s", rate, stars)
    uncLbl.TextColor3=uncColor
    barGrad.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,C.accent),ColorSequenceKeypoint.new(1,uncColor)})
    tw(barFill, 0.8, {Size=UDim2.new(rate/100,0,1,0)})

    if isBlocked or rate<70 then
        panelStroke.Color=C.fail
        panelGrad.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,120,120)),ColorSequenceKeypoint.new(1,Color3.fromRGB(255,160,160))})
        statusLbl.Text = isBlocked and "✗  Executor không hỗ trợ" or string.format("✗  UNC thấp (%d%% < 70%%)", rate)
        statusLbl.TextColor3=C.fail
        local db=mkBtn("💬  Discord (Copy Link)",C.btnBlock,UDim2.new(1,-40,0,44),UDim2.new(0,20,0,196))
        db.MouseButton1Click:Connect(function()
            if setclipboard then setclipboard("https://discord.gg/deVVQEVybd"); db.Text="✓  Copied!"; task.wait(2); db.Text="💬  Discord (Copy Link)"
            else db.Text="setclipboard không hỗ trợ" end
        end)
    else
        statusLbl.Text="✿  Chọn phiên bản của bạn"; statusLbl.TextColor3=Color3.fromRGB(255,255,255)
        pcBtn.Visible=true; mobileBtn.Visible=true

        local function loadScript(url, platform)
            pcBtn.Active=false; mobileBtn.Active=false
            tw(pcBtn,0.15,{BackgroundTransparency=0.5}); tw(mobileBtn,0.15,{BackgroundTransparency=0.5})
            local dots=""
            local dot=task.spawn(function() while true do dots=dots=="..."and""or dots.."."
                loadLbl.Text="Đang tải "..platform..dots; task.wait(0.4) end end)
            task.wait(0.7); task.cancel(dot); loadLbl.Text="✿  Đang khởi động..."
            tw(panel,0.35,{BackgroundTransparency=1,Size=UDim2.fromOffset(W*0.82,H*0.82)})
            tw(panelStroke,0.35,{Transparency=1})
            tw(dof,0.35,{NearIntensity=0})
            task.wait(0.4); sg:Destroy(); dof:Destroy()
            local ok,err=pcall(function() loadstring(game:HttpGet(url))() end)
            if not ok then warn("[TokaiHub] "..tostring(err)) end
        end

        pcBtn.MouseButton1Click:Connect(function() loadScript(URL_PC,"PC") end)
        mobileBtn.MouseButton1Click:Connect(function() loadScript(URL_MOBILE,"Mobile") end)
    end
end)
