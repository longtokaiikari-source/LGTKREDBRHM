-- ─── Fast UNC Check (no I/O, no network, instant) ────────────────────
local function fastUNC()
    local checks = {
        -- Core executor functions (existence check, no side effects)
        "hookfunction","hookmetatable","getgc","getreg","getgenv","getupvalues",
        "checkclosure","isourclosure","newcclosure","setclipboard","getloadedmodules",
        "getnilinstances","gethui","getrawmetatable","getconnections","iscclosure",
        "islclosure","isexecutorclosure","cloneref","compareinstances","clonefunction",
        "getcallbackvalue","fireclickdetector","gethiddenproperty","sethiddenproperty",
        "isscriptable","setscriptable","getinstances","getrenv","getrunningscripts",
        "getscriptbytecode","getscripts","getsenv","getthreadidentity","setthreadidentity",
        "isreadonly","setreadonly","setrawmetatable","getnamecallmethod","hookmetamethod",
        "checkcaller","loadstring","readfile","writefile","isfile","isfolder","makefolder",
        "listfiles","delfile","delfolder","appendfile","loadfile","getcustomasset",
        "identifyexecutor","lz4compress","lz4decompress","request","setfpscap",
        "getscripthash","debug.getconstant","debug.getconstants","debug.getinfo",
        "debug.getproto","debug.getprotos","debug.getstack","debug.getupvalue",
        "debug.getupvalues","debug.setconstant","debug.setupvalue","debug.setstack",
        "crypt.base64encode","crypt.base64decode","crypt.encrypt","crypt.decrypt",
        "crypt.generatebytes","crypt.generatekey","crypt.hash",
        "Drawing","isrenderobj","getrenderproperty","setrenderproperty","cleardrawcache",
        "WebSocket","queue_on_teleport","messagebox","isrbxactive",
        "cache.invalidate","cache.iscached","cache.replace",
    }

    -- Quick functional verify (lightweight, no I/O)
    local function quickTest(name)
        local fenv = getfenv(0)
        local val = fenv
        for part in name:gmatch("[^.]+") do val = type(val)=="table" and val[part] or nil end
        return val ~= nil
    end

    local pass, fail = 0, 0
    for _, name in checks do
        if quickTest(name) then pass += 1 else fail += 1 end
    end

    -- 3 lightweight functional tests (no network/file I/O)
    local function tryTest(fn)
        local ok = pcall(fn)
        if ok then pass += 1 else fail += 1 end
    end

    if getgenv then tryTest(function()
        getgenv().__TOKAIHUB_UNC = true
        assert(__TOKAIHUB_UNC)
        getgenv().__TOKAIHUB_UNC = nil
    end) end

    if iscclosure then tryTest(function()
        assert(iscclosure(print) == true)
        assert(iscclosure(function() end) == false)
    end) end

    if newcclosure then tryTest(function()
        local f = function() return 42 end
        local c = newcclosure(f)
        assert(c() == 42 and f ~= c)
    end) end

    local total = pass + fail
    return total > 0 and math.round(pass / total * 100) or 0, pass, fail
end

