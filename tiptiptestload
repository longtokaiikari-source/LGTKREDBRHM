local currentExecutor  = identifyexecutor and identifyexecutor() or "Unknown"

local URL_PC     = "https://raw.githubusercontent.com/longtokaiikari-source/LGTKREDBRHM/refs/heads/main/tippc"
local URL_MOBILE = "https://raw.githubusercontent.com/longtokaiikari-source/LGTKREDBRHM/refs/heads/main/tipmobile"

-- ─── Full UNC Check (silent, async) ──────────────────────────────────
local function runUNC(onDone)
    task.spawn(function()
        local passes, fails, running = 0, 0, 0

        local function getGlobal(path)
            local value = getfenv(0)
            while value ~= nil and path ~= "" do
                local name, nextValue = string.match(path, "^([^.]+)%.?(.*)")
                value = value[name]; path = nextValue
            end
            return value
        end

        local function test(name, aliases, callback)
            running += 1
            task.spawn(function()
                if callback and getGlobal(name) then
                    local ok = pcall(callback)
                    if ok then passes += 1 else fails += 1 end
                elseif callback and not getGlobal(name) then
                    fails += 1
                end
                running -= 1
            end)
        end

        -- Cache
        test("cache.invalidate",{},function() local c=Instance.new("Folder"); local p=Instance.new("Part",c); cache.invalidate(c:FindFirstChild("Part")); assert(p~=c:FindFirstChild("Part")) end)
        test("cache.iscached",{},function() local p=Instance.new("Part"); assert(cache.iscached(p)); cache.invalidate(p); assert(not cache.iscached(p)) end)
        test("cache.replace",{},function() local p=Instance.new("Part"); local f=Instance.new("Fire"); cache.replace(p,f); assert(p~=f) end)
        test("cloneref",{},function() local p=Instance.new("Part"); local c=cloneref(p); assert(p~=c); c.Name="Test"; assert(p.Name=="Test") end)
        test("compareinstances",{},function() local p=Instance.new("Part"); local c=cloneref(p); assert(compareinstances(p,c)) end)

        -- Closures
        test("checkcaller",{},function() assert(checkcaller()) end)
        test("clonefunction",{},function() local f=function() return "success" end; local c=clonefunction(f); assert(f()==c() and f~=c) end)
        test("getcallingscript",{})
        test("hookfunction",{"replaceclosure"},function() local f=function() return true end; local r=hookfunction(f,function() return false end); assert(f()==false and r()==true) end)
        test("iscclosure",{},function() assert(iscclosure(print)==true and iscclosure(function()end)==false) end)
        test("islclosure",{},function() assert(islclosure(print)==false and islclosure(function()end)==true) end)
        test("isexecutorclosure",{"checkclosure","isourclosure"},function() assert(isexecutorclosure(isexecutorclosure)==true and isexecutorclosure(print)==false) end)
        test("newcclosure",{},function() local f=function() return true end; local c=newcclosure(f); assert(f()==c() and f~=c and iscclosure(c)) end)
        test("loadstring",{},function() assert(assert(loadstring("return ... + 1"))(1)==2) end)

        -- Console
        test("rconsoleclear",{"consoleclear"})
        test("rconsolecreate",{"consolecreate"})
        test("rconsoledestroy",{"consoledestroy"})
        test("rconsoleinput",{"consoleinput"})
        test("rconsoleprint",{"consoleprint"})
        test("rconsolesettitle",{"rconsolename","consolesettitle"})

        -- Crypt
        test("crypt.base64encode",{"crypt.base64.encode","crypt.base64_encode","base64.encode","base64_encode"},function() assert(crypt.base64encode("test")=="dGVzdA==") end)
        test("crypt.base64decode",{"crypt.base64.decode","crypt.base64_decode","base64.decode","base64_decode"},function() assert(crypt.base64decode("dGVzdA==")=="test") end)
        test("crypt.encrypt",{},function() local k=crypt.generatekey(); local e,iv=crypt.encrypt("test",k,nil,"CBC"); assert(iv); assert(crypt.decrypt(e,k,iv,"CBC")=="test") end)
        test("crypt.decrypt",{},function() local k,iv=crypt.generatekey(),crypt.generatekey(); local e=crypt.encrypt("test",k,iv,"CBC"); assert(crypt.decrypt(e,k,iv,"CBC")=="test") end)
        test("crypt.generatebytes",{},function() local s=math.random(10,100); local b=crypt.generatebytes(s); assert(#crypt.base64decode(b)==s) end)
        test("crypt.generatekey",{},function() local k=crypt.generatekey(); assert(#crypt.base64decode(k)==32) end)
        test("crypt.hash",{},function() for _,a in{"sha1","sha384","sha512","md5","sha256"} do assert(crypt.hash("test",a)) end end)

        -- Debug
        test("debug.getconstant",{},function() local f=function() print("Hello, world!") end; assert(debug.getconstant(f,1)=="print" and debug.getconstant(f,3)=="Hello, world!") end)
        test("debug.getconstants",{},function() local f=function() local n=5000 .."x"; print("Hello, world!",n,warn) end; local c=debug.getconstants(f); assert(c[2]=="print") end)
        test("debug.getinfo",{},function() local f=function() end; local i=debug.getinfo(f); assert(i.what and i.nups~=nil) end)
        test("debug.getproto",{},function() local f=function() local function p() return true end end; local p=debug.getproto(f,1,true)[1]; assert(p and p()==true) end)
        test("debug.getprotos",{},function() local f=function() local function a() return true end; local function b() return true end end; assert(#debug.getprotos(f)>0) end)
        test("debug.getstack",{},function() local _="a".."b"; assert(debug.getstack(1,1)=="ab") end)
        test("debug.getupvalue",{},function() local u=function()end; local f=function() print(u) end; assert(debug.getupvalue(f,1)==u) end)
        test("debug.getupvalues",{},function() local u=function()end; local f=function() print(u) end; assert(debug.getupvalues(f)[1]==u) end)
        test("debug.setconstant",{},function() local f=function() return "fail" end; debug.setconstant(f,1,"success"); assert(f()=="success") end)
        test("debug.setupvalue",{},function() local u=function() return "fail" end; local f=function() return u() end; debug.setupvalue(f,1,function() return "success" end); assert(f()=="success") end)

        -- Filesystem
        test("readfile",{},function() writefile(".tests/r.txt","success"); assert(readfile(".tests/r.txt")=="success") end)
        test("listfiles",{},function() makefolder(".tests/lf"); writefile(".tests/lf/a.txt","x"); writefile(".tests/lf/b.txt","x"); assert(#listfiles(".tests/lf")==2) end)
        test("writefile",{},function() writefile(".tests/w.txt","success"); assert(readfile(".tests/w.txt")=="success") end)
        test("makefolder",{},function() makefolder(".tests/mf"); assert(isfolder(".tests/mf")) end)
        test("appendfile",{},function() writefile(".tests/af.txt","su"); appendfile(".tests/af.txt","ccess"); assert(readfile(".tests/af.txt")=="success") end)
        test("isfile",{},function() writefile(".tests/if.txt","x"); assert(isfile(".tests/if.txt")==true and isfile(".tests")==false) end)
        test("isfolder",{},function() assert(isfolder(".tests")==true and isfolder(".tests/nope.exe")==false) end)
        test("delfolder",{},function() makefolder(".tests/df"); delfolder(".tests/df"); assert(not isfolder(".tests/df")) end)
        test("delfile",{},function() writefile(".tests/del.txt","x"); delfile(".tests/del.txt"); assert(not isfile(".tests/del.txt")) end)
        test("loadfile",{},function() writefile(".tests/lf2.txt","return ...+1"); assert(assert(loadfile(".tests/lf2.txt"))(1)==2) end)
        test("dofile",{})

        -- Input
        test("isrbxactive",{"isgameactive"},function() assert(type(isrbxactive())=="boolean") end)
        test("mouse1click",{}); test("mouse1press",{}); test("mouse1release",{})
        test("mouse2click",{}); test("mouse2press",{}); test("mouse2release",{})
        test("mousemoveabs",{}); test("mousemoverel",{}); test("mousescroll",{})

        -- Instances
        test("fireclickdetector",{},function() local d=Instance.new("ClickDetector"); fireclickdetector(d,50,"MouseHoverEnter") end)
        test("getcallbackvalue",{},function() local b=Instance.new("BindableFunction"); local f=function()end; b.OnInvoke=f; assert(getcallbackvalue(b,"OnInvoke")==f) end)
        test("getconnections",{},function() local b=Instance.new("BindableEvent"); b.Event:Connect(function()end); local c=getconnections(b.Event)[1]; assert(c.Function and c.Disconnect) end)
        test("getcustomasset",{},function() writefile(".tests/ga.txt","x"); local c=getcustomasset(".tests/ga.txt"); assert(type(c)=="string" and c:find("rbxasset://")) end)
        test("gethiddenproperty",{},function() local f=Instance.new("Fire"); local p,h=gethiddenproperty(f,"size_xml"); assert(p==5 and h==true) end)
        test("sethiddenproperty",{},function() local f=Instance.new("Fire"); local h=sethiddenproperty(f,"size_xml",10); assert(h and gethiddenproperty(f,"size_xml")==10) end)
        test("gethui",{},function() assert(typeof(gethui())=="Instance") end)
        test("getinstances",{},function() assert(getinstances()[1]:IsA("Instance")) end)
        test("getnilinstances",{},function() assert(getnilinstances()[1].Parent==nil) end)
        test("isscriptable",{},function() local f=Instance.new("Fire"); assert(isscriptable(f,"size_xml")==false and isscriptable(f,"Size")==true) end)
        test("setscriptable",{},function() local f=Instance.new("Fire"); local w=setscriptable(f,"size_xml",true); assert(w==false and isscriptable(f,"size_xml")==true) end)
        test("setrbxclipboard",{})

        -- Metatable
        test("getrawmetatable",{},function() local mt={__metatable="Locked!"}; local o=setmetatable({},mt); assert(getrawmetatable(o)==mt) end)
        test("hookmetamethod",{},function() local o=setmetatable({},{__index=newcclosure(function() return false end),__metatable="Locked!"}); local r=hookmetamethod(o,"__index",function() return true end); assert(o.test==true and r()==false) end)
        test("getnamecallmethod",{},function() local m; local r; r=hookmetamethod(game,"__namecall",function(...) if not m then m=getnamecallmethod() end; return r(...) end); game:GetService("Lighting"); assert(m=="GetService") end)
        test("isreadonly",{},function() local o={}; table.freeze(o); assert(isreadonly(o)) end)
        test("setrawmetatable",{},function() local o=setmetatable({},{__index=function() return false end,__metatable="Locked!"}); setrawmetatable(o,{__index=function() return true end}); assert(o.test==true) end)
        test("setreadonly",{},function() local o={success=false}; table.freeze(o); setreadonly(o,false); o.success=true; assert(o.success) end)

        -- Misc
        test("identifyexecutor",{"getexecutorname"},function() local n=identifyexecutor(); assert(type(n)=="string") end)
        test("lz4compress",{},function() local r="Hello, world!"; local c=lz4compress(r); assert(lz4decompress(c,#r)==r) end)
        test("lz4decompress",{},function() local r="Hello, world!"; local c=lz4compress(r); assert(lz4decompress(c,#r)==r) end)
        test("messagebox",{})
        test("queue_on_teleport",{"queueonteleport"})
        test("request",{"http.request","http_request"},function() local r=request({Url="https://httpbin.org/user-agent",Method="GET"}); assert(type(r)=="table" and r.StatusCode==200) end)
        test("setclipboard",{"toclipboard"})
        test("setfpscap",{},function() local rs=game:GetService("RunService").RenderStepped; setfpscap(60); task.wait(0.1); setfpscap(0) end)

        -- Scripts
        test("getgc",{},function() local gc=getgc(); assert(type(gc)=="table" and #gc>0) end)
        test("getgenv",{},function() getgenv().__TOKAIHUB_TEST=true; assert(__TOKAIHUB_TEST); getgenv().__TOKAIHUB_TEST=nil end)
        test("getloadedmodules",{},function() local m=getloadedmodules(); assert(type(m)=="table" and #m>0 and typeof(m[1])=="Instance") end)
        test("getrenv",{},function() assert(_G~=getrenv()._G) end)
        test("getrunningscripts",{},function() local s=getrunningscripts(); assert(type(s)=="table" and #s>0) end)
        test("getscriptbytecode",{"dumpstring"},function() local a=game:GetService("Players").LocalPlayer.Character.Animate; assert(type(getscriptbytecode(a))=="string") end)
        test("getscripts",{},function() local s=getscripts(); assert(type(s)=="table" and #s>0) end)
        test("getsenv",{},function() local a=game:GetService("Players").LocalPlayer.Character.Animate; local e=getsenv(a); assert(type(e)=="table" and e.script==a) end)
        test("getthreadidentity",{"getidentity","getthreadcontext"},function() assert(type(getthreadidentity())=="number") end)
        test("setthreadidentity",{"setidentity","setthreadcontext"},function() setthreadidentity(3); assert(getthreadidentity()==3) end)

        -- Drawing
        test("Drawing",{})
        test("Drawing.new",{},function() local d=Drawing.new("Square"); d.Visible=false; pcall(function() d:Destroy() end) end)
        test("Drawing.Fonts",{},function() assert(Drawing.Fonts.UI==0 and Drawing.Fonts.System==1 and Drawing.Fonts.Plex==2 and Drawing.Fonts.Monospace==3) end)
        test("isrenderobj",{},function() local d=Drawing.new("Image"); d.Visible=true; assert(isrenderobj(d)==true and isrenderobj(newproxy())==false) end)
        test("getrenderproperty",{},function() local d=Drawing.new("Image"); d.Visible=true; assert(type(getrenderproperty(d,"Visible"))=="boolean") end)
        test("setrenderproperty",{},function() local d=Drawing.new("Square"); d.Visible=true; setrenderproperty(d,"Visible",false); assert(d.Visible==false) end)
        test("cleardrawcache",{},function() cleardrawcache() end)

        -- WebSocket
        test("WebSocket",{})
        test("WebSocket.connect",{},function() local ws=WebSocket.connect("ws://echo.websocket.events"); assert(type(ws.Send)=="function" and type(ws.Close)=="function"); ws:Close() end)

        -- Wait for all async tests
        repeat task.wait() until running == 0

        local total = passes + fails
        local rate = total > 0 and math.round(passes/total*100) or 0
        onDone(rate, passes, fails)
    end)
end

